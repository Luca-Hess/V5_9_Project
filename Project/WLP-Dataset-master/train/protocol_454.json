    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\ncentrifuge(container='bacteria broth culture (500ul)', volume='500ul', duration='10 minutes', speed='10000g')\n\n### MANUAL SECTION ###\n# MANUAL: pour (container: centrifuged tube, reagent: supernatant, other: {})\n\n### AUTOMATED SECTION ###\nadd(container='pellet in tube', reagent='Lysis buffer', volume='200ul')\nadd(container='pellet in tube', reagent='Proteinase K', volume='20ul')\nvortex(container='tube with pellet, Lysis buffer, Proteinase K', duration='15 seconds')\ncentrifuge(container='tube after vortex', purpose='spin down')\nincubate(container='tube with lysed sample', temperature='56 C', duration='1 hour')\nadd(container='tube after incubation', reagent='Binding Buffer', volume='200ul')\nadd(container='tube after incubation', reagent='Ethanol', volume='200ul')\nvortex(container='tube with sample, Binding Buffer, Ethanol', duration='15 seconds')\ncentrifuge(container='tube after vortex', purpose='spin down')\ntransfer(container='spin column and collection tube', reagent='sample', volume='600ul')\ncentrifuge(container='spin column and collection tube', duration='1 minute', speed='high')\n\n### MANUAL SECTION ###\n# MANUAL: dispose (container: collection tube, reagent: flow through, other: {})\n\n### AUTOMATED SECTION ###\nadd(container='spin column', reagent='Wash Buffer', volume='500ul')\ncentrifuge(container='spin column and collection tube', duration='1 minute', speed='high')\n\n### MANUAL SECTION ###\n# MANUAL: dispose (container: collection tube, reagent: flow through, other: {})\n\n### AUTOMATED SECTION ###\nadd(container='spin column', reagent='Wash Buffer', volume='500ul', note='another')\ncentrifuge(container='spin column and collection tube', duration='1 minute', speed='high')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: spin column, other: {'destination': 'new collection tube'})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='spin column and new collection tube', duration='2 minutes', speed='high')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: spin column, other: {'destination': 'clean tube'})\n\n### AUTOMATED SECTION ###\nadd(container='spin column', reagent='TE buffer', volume='100ul')\nincubate(container='spin column in clean tube', temperature='RT', duration='2 minutes')\ncentrifuge(container='spin column and clean tube', duration='1 minute', speed='high')\nadd(container='spin column', reagent='TE buffer', volume='100ul', note='another')\nincubate(container='spin column in clean tube', temperature='RT', duration='1 minute')\ncentrifuge(container='spin column and clean tube', duration='1 minute', speed='high')\n\n### MANUAL SECTION ###\n# MANUAL: discard (container: spin column, other: {})",
