    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\nresuspend(container='5 mL (12 x 75 mm) polystyrene tube', reagent='MojoSort\u2122 Buffer', volume='up to 4 mL', cells='from tissue of interest')\n\n### MANUAL SECTION ###\n# MANUAL: filter (other: {'cell_strainer': '70 \u03bcm'})\n\n### AUTOMATED SECTION ###\ncentrifuge(duration='5 minutes', speed='300 x g')\nresuspend(reagent='MojoSort\u2122 Buffer', volume='appropriate volume')\n\n### MANUAL SECTION ###\n# MANUAL: count (other: {'cell_concentration': '1 x 10^8 cells/mL'})\n# MANUAL: adjust (other: {'cell_concentration': '1 x 10^8 cells/mL'})\n\n### AUTOMATED SECTION ###\naliquot(container='new tube', reagent='cell suspension', volume='100 \u03bcL', cells='10^7 cells')\nresuspend(reagent='Nanobeads', speed='maximum speed', method='vortexing', touches='5')\nadd(reagent='Nanobeads', volume='10 \u03bcL')\nmix()\nincubate(temperature='on ice', duration='15 minutes')\nadd(reagent='Nanobeads', volume='100 \u03bcL', cells='1 x 10^8 cells')\nresuspend(reagent='MojoSort\u2122 Buffer', volume='3 mL')\naliquot(volume='small aliquot', purpose='monitor purity and yield')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: tube, duration: 5 minutes, other: {'equipment': 'magnet'})\n# MANUAL: pour (reagent: liquid)\n\n### AUTOMATED SECTION ###\nresuspend(reagent='appropriate buffer', cells='labeled cells')\n\n### MANUAL SECTION ###\n# MANUAL: repeat (other: {'steps': '6-8', 'times': '2 more times'})\n\n### AUTOMATED SECTION ###\naliquot(volume='small aliquot', purpose='monitor purity and yield')\n\n### MANUAL SECTION ###\n# MANUAL: pool (reagent: unlabeled fractions, other: {'process_with': 'positive labeled cells'})",
