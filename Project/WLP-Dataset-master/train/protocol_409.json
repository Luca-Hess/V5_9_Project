    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: transform (reagent: DE3 GOLD cells, nm2973 plasmid, other: {'plate_on': 'LB + 50\u03bcg/mL Carbenicillin'})\n# MANUAL: inoculate (reagent: 25mL LB + 50\u03bcg/mL Carbenicillin, volume: 25mL, other: {'source': 'bacteria from fresh transformation'})\n\n### AUTOMATED SECTION ###\nincubate(temperature='37\u00b0C', duration='overnight')\ntransfer(reagent='overnight culture', volume='5mL', destination='1L LB + 0.1% glucose + 50\u03bcg/mL Carbenicillin')\ngrow(temperature='25\u00b0C', to_OD600='~0.5')\nshift(reagent='culture', temperature='18\u00b0C', duration='15-25 minutes')\nadd(reagent='IPTG', final_concentration='0.2 mM')\nincubate(duration='overnight')\ncentrifuge(reagent='culture', purpose='pellet culture')\n\n### MANUAL SECTION ###\n# MANUAL: obtain (reagent: wet weight)\n\n### AUTOMATED SECTION ###\nresuspend(reagent='Buffer A + protease inhibitor + 1mM PMSF', volume='~6 mL/g cells')\n\n### MANUAL SECTION ###\n# MANUAL: sonicate (duration: 6 x 45s, speed: setting 3 at 30%, 1s pulse-2s pause, other: {'cooling': '1 minute between cycles'})\n\n### AUTOMATED SECTION ###\ncentrifuge(reagent='lysate', duration='30 minutes', speed='16000xg')\ntransfer(container='fresh tube', reagent='supernatant')\nequilibrate(container='5mL Ni-agarose column', reagent='Buffer A', volume='at least 25mL')\nbatch_bind(reagent='clarified lysate, Ni-agarose', temperature='4\u00b0C', duration='45 minutes')\nwash(container='Ni-agarose column', reagent='Buffer B', volume='100mL')\nelute(container='Ni-agarose column', reagent='Buffer C', target='protein')\n\n### MANUAL SECTION ###\n# MANUAL: determine (reagent: fractions, other: {'method': 'Bradford assay or SDS-PAGE'})\n\n### AUTOMATED SECTION ###\npool(reagent='fractions')\nequilibrate(container='5mL Q Sepharose column', reagent='1M KCl', volume='25mL', purpose='charge column')\nequilibrate(container='Q Sepharose column', reagent='Buffer C', volume='25mL')\nflow(container='Q Sepharose column', reagent='eluent (from step 17)')\ncollect(reagent='flow-through')\n\n### MANUAL SECTION ###\n# MANUAL: dialyze (reagent: flow-through, volume: 1L Buffer D, temperature: 4\u00b0C, duration: 5 hours)\n\n### AUTOMATED SECTION ###\ntransfer(volume='1L Buffer D')\n\n### MANUAL SECTION ###\n# MANUAL: dialyze (volume: 1L Buffer D, duration: overnight)\n\n### AUTOMATED SECTION ###\nconcentrate(container='100K centrifugal filter', reagent='protein', volume='~10 mg/mL')\naliquot(reagent='protein')\n\n### MANUAL SECTION ###\n# MANUAL: freeze (reagent: aliquots, temperature: liquid nitrogen, other: {'method': 'flash-freeze'})\n\n### AUTOMATED SECTION ###\nstore(reagent='aliquots', temperature='-80\u00b0C')",
