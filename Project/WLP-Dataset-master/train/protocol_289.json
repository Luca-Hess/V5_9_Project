    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: prepare (reagent: cesium chloride in seawater (filtered and autoclaved), other: {'densities': ['1.2', '1.4', '1.5', '1.65 g/mL'], 'filtration': '0.02\u03bcm or 0.2\u03bcm', 'autoclaved': True})\n# MANUAL: place (container: tube of prepared cesium, other: {'location': 'balance'})\n# MANUAL: tare (container: balance, other: {'value': '0'})\n\n### AUTOMATED SECTION ###\nremove(container='tube of prepared cesium', reagent='cesium chloride solution', volume='1ml', tool='sterile pipet tip')\nlayer(container='tube', reagent='CsCl', method='from the bottom using gradient fractionator or by hand')\nlayer(container='tube (SW40 or SW28)', reagent='sample', volume='~5ml (SW40), ~15ml (SW28)', method='carefully')\n\n### MANUAL SECTION ###\n# MANUAL: weigh (container: tubes, other: {})\n# MANUAL: balance (container: tubes, other: {})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='tubes (SW40 or SW28 Beckman rotor)', temperature='4\u00b0C', duration='4hr', speed='24,000rpm')\n\n### MANUAL SECTION ###\n# MANUAL: label (container: sterile 0.5ml tubes (SW40) or 1.5ml tubes (SW28), other: {'labels': '1-24'})\n# MANUAL: open (container: tubes in rack, other: {})\n# MANUAL: place (container: tube, other: {'location': 'ring stand'})\n# MANUAL: puncture (container: tube, other: {'location': '2mm from bottom side', 'tool': 'sterile 20 gauge needle, bevel up'})\n\n### AUTOMATED SECTION ###\ncollect(container='tubes (1-24)', reagent='droplets', volume='to fill each tube', order='in order')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: tube with sample, other: {'location': '4-place balance in holder'})\n# MANUAL: tare (container: balance, other: {'value': '0'})\n\n### AUTOMATED SECTION ###\nremove(container='tube with sample', reagent='sample', volume='100\u00b5l', tool='sterile pipet tip')\n\n### MANUAL SECTION ###\n# MANUAL: measure (container: removed sample, volume: 100\u00b5l, other: {})\n\n### AUTOMATED SECTION ###\nreturn(container='tube with sample', reagent='sample', volume='100\u00b5l')\nremove(container='tube with sample', reagent='sample', volume='100\u00b5l', tool='sterile pipet tip')\n\n### MANUAL SECTION ###\n# MANUAL: measure (container: removed sample, volume: 100\u00b5l, other: {})\n\n### AUTOMATED SECTION ###\nreturn(container='tube with sample', reagent='sample', volume='100\u00b5l')\nremove(container='tube with sample', reagent='sample', volume='100\u00b5l', tool='sterile pipet tip')\n\n### MANUAL SECTION ###\n# MANUAL: measure (container: removed sample, volume: 100\u00b5l, other: {})\n\n### AUTOMATED SECTION ###\nreturn(container='tube with sample', reagent='sample', volume='100\u00b5l')\n\n### MANUAL SECTION ###\n# MANUAL: average (container: tube, other: {'values': '3 measurements per tube'})\n# MANUAL: multiply (other: {'factor': '10'})\n\n### AUTOMATED SECTION ###\npool(container='tubes', reagent='samples')\n\n### MANUAL SECTION ###\n# MANUAL: extract (container: pooled sample, reagent: DNA, other: {})\n# MANUAL: confirm (container: sample, reagent: virus, other: {'method': 'staining 10\u00b5l with SYBR gold'})\n\n### AUTOMATED SECTION ###\nstain(container='sample', reagent='SYBR gold', volume='10\u00b5l')\n\n### MANUAL SECTION ###\n# MANUAL: count (container: sample, reagent: virus, other: {'method': 'fluorescent scope'})\n\n### AUTOMATED SECTION ###\npool(container='samples with virus')",
