    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: prepare (reagent: lysis buffer, other: {})\n# MANUAL: prepare (reagent: Lysozyme & RNase aliquot, other: {})\n# MANUAL: prepare (reagent: ProK aliquot, other: {})\n# MANUAL: thaw (container: filters, temperature: on ice, other: {})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='filters', duration='quick')\n\n### MANUAL SECTION ###\n# MANUAL: transfer (container: screw top, O-ringed eppendorf tube, reagent: filter, temperature: on ice, other: {})\n\n### AUTOMATED SECTION ###\nadd(container='eppendorf tube', reagent='lysis buffer with RNase and lysozyme', volume='250 \u00b5l')\nincubate(container='eppendorf tube', temperature='37\u00b0C', duration='30 min', speed='rotating end over end at angle', mixing='optimal mixing with minimal frothing')\nadd(container='eppendorf tube', reagent='Proteinase K solution (10 mg/ml made up in lysis buffer)', volume='18.75 \u00b5l', final_concentration='0.65 mg/ml')\nadd(container='eppendorf tube', reagent='10% SDS', volume='29.9 \u00b5l', final_concentration='1%')\nincubate(container='eppendorf tube', temperature='55\u00b0C', duration='2 hours', speed='rotating end over end at angle')\nheat(container='heat block or hyb oven', temperature='70\u00b0C')\npreheat(reagent='elution liquid (Buffer AE or water)', temperature='70\u00b0C')\nadd(reagent='Buffer AL (=Buffer AL/E without the ethanol added)', volume='300 \u00b5l')\nmix(speed='thoroughly by vortexing')\ncentrifuge(duration='quick')\nincubate(temperature='70\u00b0C', duration='10 min')\nadd(reagent='96-100% EtOH', volume='300 \u00b5l')\nmix(speed='vortexing vigorously')\ncentrifuge(duration='quick')\n\n### MANUAL SECTION ###\n# MANUAL: check (reagent: lysate, other: {'pH': '<7'})\n\n### AUTOMATED SECTION ###\npipette(container='96 well spin columns', reagent='lysate', avoid_wetting_rims=True)\n\n### MANUAL SECTION ###\n# MANUAL: place (container: 96 well column plate, other: {'location': 'S-block for flow through collection'})\n\n### AUTOMATED SECTION ###\nseal(container='plate', reagent='Airpore tape sheet')\ncentrifuge(container='sealed plate', temperature='40\u00b0C', duration='10 min', speed='5788 xg')\n\n### MANUAL SECTION ###\n# MANUAL: discard (container: flow through, other: {})\n# MANUAL: place (container: column plate, other: {'location': 'new collection tray'})\n\n### AUTOMATED SECTION ###\nadd(reagent='additional lysate')\ncentrifuge()\nadd(reagent='Buffer AW1', volume='500 \u00b5l')\nseal(container='plate')\ncentrifuge(container='sealed plate', temperature='40\u00b0C', duration='5 min', speed='5788 xg')\nadd(reagent='Buffer AW2', volume='500 \u00b5l')\nseal(container='plate')\ncentrifuge(container='sealed plate', temperature='40\u00b0C', duration='5 min', speed='5788 xg')\ndry(container='columns', duration='15 min', speed='5600 xg', method='centrifuge or incubate at 70\u00b0C')\nincubate(container='columns', temperature='70\u00b0C', duration='15 min', method='hyb oven')\n\n### MANUAL SECTION ###\n# MANUAL: transfer (container: top of rack of elution microtubes RS, reagent: column plate, other: {})\n\n### AUTOMATED SECTION ###\nadd(container='column plate', reagent='pre-heated 70\u00b0C Buffer AE or water', volume='200 \u00b5l', temperature='70\u00b0C')\nseal(container='plate')\nincubate(container='plate', temperature='RT', duration='1 min')\ncentrifuge(container='plate', duration='2 min', speed='5788 xg', purpose='elute')\nrepeat(container='column plate', reagent='200 \u00b5l Buffer AE or water', volume='200 \u00b5l', temperature='70\u00b0C', purpose='increase yield')\nheat(reagent='first 200 \u00b5l elution', volume='200 \u00b5l', temperature='70\u00b0C', purpose='pass through column again')\n\n### MANUAL SECTION ###\n# MANUAL: freeze (container: elutants, duration: overnight or for a while, other: {'purpose': 'storage before DNA clean up'})\n\n### AUTOMATED SECTION ###\ntransfer(container='96 well PCR purification plate', reagent='eluted DNA', volume='\u2264300 \u00b5l')\napply(container='PCR purification plate', reagent='vacuum', duration='20-30 min', speed='20 inches Hg', purpose='dry')\nrinse(container='PCR purification plate', reagent='Ambion water', volume='100 \u00b5l')\napply(container='PCR purification plate', reagent='vacuum', duration='5-10 min', purpose='dry')\nrinse(container='PCR purification plate', reagent='water', purpose='remove Buffer TE')\nadd(container='PCR purification plate', reagent='dilute TE', volume='20 \u00b5l')\npipette(container='PCR purification plate', speed='up and down 20 times')\ntransfer(container='clean 96 well plate')",
