    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: label (container: 1.5 ml tubes (11), other: {'labels': ['40', '45', '50', '55', '...', '90']})\n\n### AUTOMATED SECTION ###\nmix(reagent=['48\u03bcl NEB 100bp ladder', '1152\u03bcl Molecular Biology Water'], volume='total 1200\u03bcl')\npipette(container='11x1.5 ml tubes', reagent='mixture (NEB 100bp ladder + water)', volume='100\u03bcl per tube')\nvortex(container='bottle of AmPure XP beads', reagent='AmPure XP beads')\ndispense(container='fresh tube', reagent='AmPure XP beads', volume='800\u03bcl')\npipette(container='11x1.5 ml tubes', reagent='AmPure XP beads', volume='variable (40\u03bcl into tube 40, 45\u03bcl into tube 45, etc.)', mapping='tube label to bead volume')\n\n### MANUAL SECTION ###\n# MANUAL: close (container: tubes)\n\n### AUTOMATED SECTION ###\nvortex(container='tubes')\nincubate(container='tubes', temperature='room temperature', duration='5 minutes')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: tubes, other: {'location': 'MPC rack'})\n\n### AUTOMATED SECTION ###\nwait(container='tubes in MPC rack', duration='5 minutes', purpose='beads adhere to magnet side')\npipette(container='tubes', reagent='supernatant', volume='all', destination='waste')\nwash(container='tubes', reagent='70% ethanol', volume='500\u03bcl per wash, 2x', duration='30 seconds per wash')\nremove(container='tubes', reagent='supernatant', volume='all')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: tubes (caps open), temperature: 37\u00b0C, other: {'location': 'heat block'})\n\n### AUTOMATED SECTION ###\ndry(container='tubes', reagent='beads', temperature='37\u00b0C', purpose='evaporate residual ethanol')\nadd(container='tubes', reagent='Qiagen EB', volume='10\u03bcl per tube')\n\n### MANUAL SECTION ###\n# MANUAL: close (container: tubes)\n\n### AUTOMATED SECTION ###\nvortex(container='tubes', reagent='beads', purpose='resuspend beads')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: tubes, other: {'location': 'MPC rack'})\n\n### AUTOMATED SECTION ###\nwait(container='tubes in MPC rack', purpose='let beads adhere to magnet sides')\npipette(container='tubes', reagent='supernatant (eluted DNA)', volume='all', destination='fresh tubes')\n\n### MANUAL SECTION ###\n# MANUAL: run (container: 2% agarose gel (1x TAE), reagent: ['5\u03bcl DNA', '1\u03bcl 6x gel loading buffer'], other: {'purpose': 'electrophoresis'})\n# MANUAL: photograph (container: gel)\n# MANUAL: determine (other: {'purpose': 'what ratio of beads to DNA to use to exclude lower range of DNA'})",
