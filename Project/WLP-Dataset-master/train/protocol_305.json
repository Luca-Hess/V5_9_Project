    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: prepare (container: tube, reagent: mucin sample, other: {})\n# MANUAL: assign (container: tube, reagent: mucin sample, volume: 10ul, 20ul, 30ul, other: {})\n\n### AUTOMATED SECTION ###\nadd(container='tube', reagent='DDI water', volume='to reach 30ul total per tube')\nadd(container='tube', reagent='loading buffer')\nheat(container='tube', reagent='sample solution', temperature='95\u00b0C', duration='10 min')\n\n### MANUAL SECTION ###\n# MANUAL: load (reagent: running buffer, other: {})\n\n### AUTOMATED SECTION ###\nadd(container='electrophoresis cell', reagent='running buffer', volume='some')\n\n### MANUAL SECTION ###\n# MANUAL: peel (container: gel, other: {'material': 'green paste at bottom'})\n# MANUAL: remove (container: gel, other: {'material': 'top green plastic cover'})\n# MANUAL: set (container: electrophoresis cell, reagent: gel, other: {})\n\n### AUTOMATED SECTION ###\nfill(container='inner and outer buffer chambers', reagent='running buffer')\n\n### MANUAL SECTION ###\n# MANUAL: check (container: electrophoresis cell, reagent: running buffer, other: {'condition': 'level above top of gel, no leakage'})\n# MANUAL: perform (container: electrophoresis cell, other: {'process': 'electrophoresis'})\n\n### AUTOMATED SECTION ###\nload(container='gel', reagent='protein sample')\n\n### MANUAL SECTION ###\n# MANUAL: connect (container: electrophoresis cell, reagent: power supply, other: {'run conditions': '150-200 V', 'run time': 'until loading buffer line reaches bottom of gel'})\n\n### AUTOMATED SECTION ###\nstain(container='gel', reagent='PageBlue', duration='overnight', speed='agitate')\nwash(container='gel', reagent='DI H2O')\n\n### MANUAL SECTION ###\n# MANUAL: remove (container: staining container, reagent: water, volume: all, other: {})\n\n### AUTOMATED SECTION ###\nadd(container='staining container', reagent='PageBlue stain')\nagitate(container='