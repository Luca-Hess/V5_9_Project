    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: weigh (container: test tube, reagent: oil, volume: 0.01 mg, other: {'record_exact_weight': True})\n\n### AUTOMATED SECTION ###\nmelt(reagent='solid fat')\ndilute(reagent='sample with high PV', serial=True, solvent='working solvent')\n\n### MANUAL SECTION ###\n# MANUAL: record (other: {'dilution_factor': True})\n# MANUAL: weigh (reagent: sample with very low PV, volume: up to 0.10 g, other: {})\n\n### AUTOMATED SECTION ###\nadd(container='test tube', reagent='working solvent', volume='3 mL', immediately=True)\nvortex(container='test tube', reagent='oil + working solvent', to_dissolve=True, ensure_fully_dissolved=True)\n\n### MANUAL SECTION ###\n# MANUAL: prepare (container: blank tube, reagent: working solvent, other: {'no_sample': True})\n\n### AUTOMATED SECTION ###\nadd(container='all tubes', reagent='ammonium thiocyanate', volume='15 \u03bcl')\nvortex(container='all tubes', duration='2-4 sec')\nadd(container='all tubes', reagent='ferrous chloride', volume='15 \u03bcl')\nvortex(container='all tubes', duration='2-4 sec')\nwait(container='all tubes', temperature='room temperature', duration='20 min')\n\n### MANUAL SECTION ###\n# MANUAL: protect (container: all tubes, other: {'from_bright_light': True})\n\n### AUTOMATED SECTION ###\nread(container='all tubes', instrument='spectrophotometer', wavelength='510 nm')\n\n### MANUAL SECTION ###\n# MANUAL: calculate (other: {'formula': 'PV (meq peroxide per kg sample) = (As \u2013 Ab) x m / (55.84 x m0 x 2)'})",
