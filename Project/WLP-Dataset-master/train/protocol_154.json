    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: collect (container: 2ml eppendorf tube, reagent: tissue/spores, volume: 10-20mg, other: {'metal_bead': 'one'})\n# MANUAL: lyse (container: precooled tissuelycer, reagent: tissue/spores, temperature: liquid nitrogen)\n\n### AUTOMATED SECTION ###\nmix(container='tissuelycer', reagent='tissue/spores', duration='1 min', speed='50Hz')\nmix(reagent='buffer A+B+C', volume='2.5:2.5:1 + 0.1% PVP final', purpose='make lysis buffer')\nheat(reagent='lysis buffer', temperature='64\u00b0C', duration='briefly')\ncool(reagent='lysis buffer', temperature='room temperature')\nadd(reagent='RNAse T1', volume='1:1750 ratio to lysis buffer')\nadd(container='powder in eppendorf tube', reagent='lysis buffer', volume='500ul')\nvortex(container='eppendorf tube', duration='briefly')\nincubate(container='eppendorf tube', temperature='64\u00b0C', duration='30 mins')\ncool(container='eppendorf tube', temperature='ice', duration='5 mins')\nadd(container='eppendorf tube', reagent='KAc 5M', volume='100ul (0.2 vol)')\nmix(container='eppendorf tube', method='inversion')\nincubate(container='eppendorf tube', temperature='ice', duration='max 5 mins')\ncentrifuge(container='eppendorf tube', temperature='4\u00b0C', duration='10 mins', speed='max speed')\ntransfer(container='fresh eppendorf tube', reagent='supernatant', destination_contains='500ul (1vol) (P/C/I)')\nmix(container='eppendorf tube', duration='2 mins', method='inversion')\ncentrifuge(container='eppendorf tube', temperature='4\u00b0C', duration='10 mins', speed='max speed')\ntransfer(container='fresh eppendorf tube', reagent='supernatant', volume='~400ul', destination_contains='500ul RT isopropanol')\nincubate(container='eppendorf tube', temperature='room temperature', duration='5-10 mins')\ncentrifuge(container='eppendorf tube', temperature='4\u00b0C', duration='30 mins', speed='max speed')\nremove(container='eppendorf tube', reagent='supernatant', method='pipette')\nwash(container='eppendorf tube', reagent='fresh 70% Ethanol', volume='1mL', method='invert several times to dislodge pellet')\ncentrifuge(container='eppendorf tube', duration='5 mins', speed='13000g')\nremove(container='eppendorf tube', reagent='supernatant', method='pipette')\nwash(container='eppendorf tube', reagent='fresh 70% Ethanol', volume='1mL', method='invert several times to dislodge pellet')\ncentrifuge(container='eppendorf tube', duration='5 mins', speed='13000g')\nremove(container='eppendorf tube', reagent='supernatant', method='pipette')\ncentrifuge(container='eppendorf tube', duration='1 min', speed='13000g')\nremove(container='eppendorf tube', reagent='remaining ethanol', method='pipette')\n\n### MANUAL SECTION ###\n# MANUAL: air-dry (container: eppendorf tube, reagent: pellet, duration: 7 mins)\n\n### AUTOMATED SECTION ###\nadd(container='eppendorf tube', reagent='TE buffer', volume='50ul')\n\n### MANUAL SECTION ###\n# MANUAL: mix (container: eppendorf tube, other: {'method': 'flick tube slightly'})\n# MANUAL: store (container: eppendorf tube, temperature: -20\u00b0C)",
