    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\nadd(container='1.5ml microfuge tube', reagent='nucleated blood', volume='10\u00b5l', to='tube containing 500\u00b5l Lysis Buffer')\nincubate(container='sample (microfuge tube)', temperature='55-60\u00b0C', duration='15 minutes')\nadd(container='microfuge tube', reagent='Proteinase K solution', volume='1\u00b5l per 100\u00b5l Lysis Buffer', optional=True)\nincubate(container='sample (microfuge tube)', temperature='60\u00b0C', duration='1-2 hours', optional=True)\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: tube, duration: periodically each hour, other: {})\n\n### AUTOMATED SECTION ###\ncool(container='sample (microfuge tube)', temperature='room temperature')\nadd(container='microfuge tube', reagent='chloroform', volume='200\u00b5l')\n\n### MANUAL SECTION ###\n# MANUAL: mix (container: tube, other: {'method': 'invert several times'})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='tube', duration='10 minutes', speed='14,000xg')\nremove(container='tube', reagent='upper phase', to='clean microcentrifuge tube')\nadd(container='sample (clean microcentrifuge tube)', reagent='DNA Stripping Solution', volume='50\u00b5l')\n\n### MANUAL SECTION ###\n# MANUAL: mix (container: tube, other: {'method': 'invert several times'})\n\n### AUTOMATED SECTION ###\nincubate(container='sample (tube)', temperature='60\u00b0C', duration='5-10 minutes')\nadd(container='tube', reagent='Precipitation Solution', volume='100\u00b5l')\n\n### MANUAL SECTION ###\n# MANUAL: mix (container: tube, other: {'method': 'invert several times'})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='sample (tube)', duration='5 minutes', speed='14,000xg')\ntransfer(container='tube', reagent='supernatant', to='clean tube')\nadd(container='clean tube', reagent='isopropanol', volume='500\u00b5l', purpose='precipitate genomic DNA')\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: tube, other: {'times': '10'})\n\n### AUTOMATED SECTION ###\nadd(container='tube', reagent='Mussel Glycogen', volume='2\u00b5l', optional=True, purpose='DNA carrier')\ncentrifuge(container='tube', duration='5 minutes', speed='14,000xg', purpose='pellet genomic DNA')\nremove(container='tube', reagent='supernatant')\nadd(container='tube', reagent='70% ethanol', volume='700\u00b5l', purpose='wash DNA pellet')\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: tube, other: {'purpose': 'wash DNA pellet'})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='tube', duration='1 minute', speed='14,000xg')\n\n### MANUAL SECTION ###\n# MANUAL: decant (container: tube, reagent: ethanol wash, other: {})\n\n### AUTOMATED SECTION ###\npipette(container='tube', reagent='ethanol wash')\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: tube, duration: several minutes, other: {'on': 'clean absorbent surface', 'purpose': 'drain excess ethanol'})\n\n### AUTOMATED SECTION ###\nadd(container='tube', reagent='TE Buffer', volume='50\u00b5l', to='pellet')\nincubate(container='tube', temperature='room temperature', duration='at least 15 minutes', purpose='rehydrate')\nadd(container='tube', reagent='LongLife\u2122 RNase', volume='1\u00b5l per 100\u00b5l TE Buffer', optional=True)\n\n### MANUAL SECTION ###\n# MANUAL: store (container: tube, reagent: DNA, temperature: 4\u00b0C, other: {'long_term': ['-20\u00b0C', '-80\u00b0C']})",
