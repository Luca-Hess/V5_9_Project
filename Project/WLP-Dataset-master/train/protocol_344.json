    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: remove (container: cell dishes, temperature: incubator to ice, other: {})\n\n### AUTOMATED SECTION ###\ncool(container='cell dishes', temperature='ice')\nrinse(container='cell dishes', reagent='ice-cold PBS', temperature='ice-cold', times=2)\n\n### MANUAL SECTION ###\n# MANUAL: scrape (container: cell dishes, other: {})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='cells', temperature='4\u00b0C', duration='10 min', speed='500 rpm')\nadd(container='cell pellets', reagent='IP lysis buffer', volume='500 ul', cell_count='up to 2E+7 cells')\nrotate(container='cell pellets with lysis buffer', temperature='4\u00b0C', duration='2 h')\ncentrifuge(container='lysate', duration='30 min', speed='14,000 rpm')\n\n### MANUAL SECTION ###\n# MANUAL: save (container: supernatant, other: {})\n# MANUAL: determine (container: supernatant, other: {'method': 'OD280'})\n# MANUAL: adjust (container: samples, other: {'to': 'same concentration'})\n# MANUAL: determine (reagent: Rockland True Blot IP beads, volume: 20 ul beads per 500 ul sample, other: {})\n\n### AUTOMATED SECTION ###\nwash(container='beads', reagent='lysis buffer', volume='1 ml', times=2)\ncentrifuge(container='beads', duration='30 s', speed='500 g')\nresuspend(container='pelleted beads', reagent='1 mg/ml BSA')\nrotate(container='beads in BSA', temperature='RT', duration='10 min')\nremove(container='beads', reagent='BSA')\nwash(container='beads', reagent='lysis buffer', times=3)\nresuspend(container='pelleted beads', reagent='lysis buffer', volume='1:1 ratio')\n\n### MANUAL SECTION ###\n# MANUAL: save (container: IP lysate, volume: 40 ul per sample, other: {'as': 'input'})\n\n### AUTOMATED SECTION ###\nadd(container='IP lysate', reagent='primary Ab and beads')\nrotate(container='IP lysate with Ab and beads', temperature='4\u00b0C', duration='overnight')\ncentrifuge(container='beads', temperature='RT', duration='30 s', speed='500 g')\ndiscard(container='supernatant')\nwash(container='beads', reagent='ice-cold lysis buffer', volume='1 ml', temperature='ice-cold', times=3)\nresuspend(container='beads', reagent='2\u00d7 loading buffer', volume='30 ul')\nboil(container='beads in loading buffer', duration='5 min')\ncentrifuge(container='beads in loading buffer', temperature='RT', duration='1 min')\n\n### MANUAL SECTION ###\n# MANUAL: save (container: supernatant, other: {})\n# MANUAL: perform (container: supernatant, other: {'method': 'SDS-PAGE'})",
