    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\ncentrifuge(container='cell suspension', temperature='4\u00b0C', duration='5 minutes', speed='1200 rpm')\nwash(container='microcentrifuge tube', reagent='cell lysis buffer', duration='2 minutes', speed='5000 rpm', beads='protein G agarose')\naspirate(container='microcentrifuge tube', reagent='supernatant', discard=True)\nwash(container='microcentrifuge tube', reagent='cell lysis buffer', beads='protein G agarose', wash_number='1/3')\nwash(container='microcentrifuge tube', reagent='cell lysis buffer', beads='protein G agarose', wash_number='2/3')\nwash(container='microcentrifuge tube', reagent='cell lysis buffer', beads='protein G agarose', wash_number='3/3')\n\n### MANUAL SECTION ###\n# MANUAL: adjust (reagent: antibody, volume: 5-10 \u00b5g/ml, other: {'diluent': 'PBS'})\n\n### AUTOMATED SECTION ###\ntransfer(reagent='diluted antibody', volume='500 \u00b5l', to='5-10 \u00b5l agarose beads', per_sample=True)\nshake(container='antibody-protein G agarose mix', temperature='4\u00b0C', duration='1 hour', rotate=True)\ncentrifuge(container='protein G beads', duration='2 minutes', speed='5000 rpm')\nwash(container='antibody-beads', reagent='cell lysis buffer', times='3')\naspirate(reagent='supernatant', discard=True)\nadd(container='cells', reagent='ice-cold lysis buffer', volume='800 \u00b5l')\nvortex(container='cells with lysis buffer')\nincubate(container='cells with lysis buffer', temperature='on ice', duration='30 minutes')\n\n### MANUAL SECTION ###\n# MANUAL: freeze (container: samples, temperature: dry ice, other: {'cycles': '2'})\n# MANUAL: thaw (container: samples, other: {'cycles': '2'})\n# MANUAL: sonicate (container: samples, duration: 15 seconds, other: {})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='lysates', temperature='pre-cooled', duration='10 minutes', speed='14,000 rpm')\n\n### MANUAL SECTION ###\n# MANUAL: keep (reagent: supernatant, other: {})\n# MANUAL: adjust (container: supernatant, reagent: protein, volume: 1-2 mg/ml, other: {'diluent': 'lysis buffer'})\n\n### AUTOMATED SECTION ###\nmix(reagent='cell extract with antibody-protein G agarose', volume='100-500 \u00b5l')\nrotate(container='samples', temperature='4\u00b0C', duration='2 hours')\ncollect(container='microcentrifuge tube', reagent='agarose beads', temperature='4\u00b0C', duration='2 minutes', speed='5000 rpm', method='pulsing')\naspirate(reagent='supernatant', discard=True)\nwash(container='microcentrifuge tube', reagent='ice-cold cell lysis buffer', beads='agarose', wash_number='1/3')\nwash(container='microcentrifuge tube', reagent='ice-cold cell lysis buffer', beads='agarose', wash_number='2/3')\nwash(container='microcentrifuge tube', reagent='ice-cold cell lysis buffer', beads='agarose', wash_number='3/3')\nremove(reagent='supernatant', after_final_wash=True)\nadd(reagent='2X SDS sample buffer', volume='20 \u00b5l')\nload(container='gel well', reagent='sample', volume='30 \u00b5l', well_thickness='1.5 mm')\n\n### MANUAL SECTION ###\n# MANUAL: run (container: gel, other: {'according_to': 'manufacturer\u2019s recommendations'})\n\n### AUTOMATED SECTION ###\nboil(temperature='95\u00b0C', duration='5 minutes')\npipette(reagent='supernatant', carefully=True, off=True)\ncentrifuge(container='beads', temperature='room temperature', duration='5 minutes', speed='maximum speed')",
