    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\nincubate(container='thermalcycler', reagent='transcription mix', temperature='37\u00b0C', duration='18 hours')\nadd(reagent='RNase-free DNase', volume='1 \u00b5l')\nincubate(temperature='room temperature', duration='20 min')\nadd(reagent='100% EtOH', volume='to 150 \u00b5l total volume')\nadd(reagent='SPRI beads (homemade SeraPure beads)', volume='50 \u00b5l or 100 \u00b5l (depending on IVT sgRNA amount)', calculation='5X volume of IVT sgRNA')\npipette(mix_times=10)\nincubate(temperature='room temperature', duration='5 min')\nplace(container='magnetic stand', duration='5 min')\ndiscard(reagent='supernatant')\nadd(reagent='80% EtOH', volume='200 \u00b5l', wash='1')\nwait(duration='2 min')\nremove(reagent='EtOH', wash='1')\nadd(reagent='80% EtOH', volume='200 \u00b5l', wash='2')\nwait(duration='2 min')\nremove(reagent='EtOH', wash='2')\n\n### MANUAL SECTION ###\n# MANUAL: air dry (reagent: pellet, duration: 5-10 min, other: {})\n\n### AUTOMATED SECTION ###\nelute(reagent='water or TE', volume='20 \u00b5l')\npipette(mix_times=10)\nincubate(temperature='room temperature', duration='2 min')\nplace(container='magnetic stand', duration='5 min')\n\n### MANUAL SECTION ###\n# MANUAL: keep (reagent: supernatant, other: {})\n\n### AUTOMATED SECTION ###\ntransfer(container='new plate / tubes', reagent='supernatant')",
