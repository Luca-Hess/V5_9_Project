    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\nadd(container='2ml microfuge tube', reagent='Lysis Buffer', volume='600\u00b5l', sample='10-30mm2 section of stained material')\nadd(container='2ml microfuge tube', reagent='Proteinase K', volume='10\u00b5l')\nmix(container='2ml microfuge tube', method='invert')\nincubate(container='2ml microfuge tube', temperature='65\u00b0C', duration='4 hours', periodic_inversions=True)\ncool(container='2ml microfuge tube', temperature='room temperature')\n\n### MANUAL SECTION ###\n# MANUAL: remove (container: 2ml microfuge tube, reagent: stained material)\n\n### AUTOMATED SECTION ###\nremove(container='2ml microfuge tube', reagent='excess buffer from material', method='pipette')\n\n### MANUAL SECTION ###\n# MANUAL: return (container: 2ml microfuge tube, reagent: stained material)\n\n### AUTOMATED SECTION ###\nadd(container='2ml microfuge tube', reagent='chloroform', volume='200\u00b5l')\nmix(container='2ml microfuge tube', method='invert several times')\ncentrifuge(container='2ml microfuge tube', duration='10 minutes', speed='14,000xg')\nremove(container='2ml microfuge tube', reagent='upper phase', transfer_to='clean microcentrifuge tube')\nadd(container='clean microcentrifuge tube', reagent='DNA Stripping Solution', volume='50\u00b5l')\nmix(container='clean microcentrifuge tube', method='invert several times')\nincubate(container='clean microcentrifuge tube', temperature='60\u00b0C', duration='5-10 minutes')\nadd(container='clean microcentrifuge tube', reagent='Precipitation Solution', volume='100\u00b5l')\nmix(container='clean microcentrifuge tube', method='invert several times')\ncentrifuge(container='clean microcentrifuge tube', duration='5 minutes', speed='14,000xg')\ntransfer(container='clean tube', reagent='supernatant')\nadd(container='clean tube', reagent='isopropanol', volume='500\u00b5l', purpose='precipitate genomic DNA')\nmix(container='clean tube', method='invert 10 times')\nadd(container='clean tube', reagent='Mussel Glycogen', volume='2\u00b5l', purpose='DNA carrier', optional=True)\ncentrifuge(container='clean tube', duration='5 minutes', speed='14,000xg', purpose='pellet genomic DNA')\nremove(container='clean tube', reagent='supernatant')\nadd(container='clean tube', reagent='70% ethanol', volume='700\u00b5l', purpose='wash DNA pellet')\nmix(container='clean tube', method='invert several times')\ncentrifuge(container='clean tube', duration='1 minute', speed='14,000xg')\nremove(container='clean tube', reagent='ethanol wash', method='decant or pipette')\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: clean tube, duration: several minutes, other: {'surface': 'clean absorbent surface', 'purpose': 'drain excess ethanol'})\n\n### AUTOMATED SECTION ###\nadd(container='clean tube', reagent='TE Buffer', volume='50\u00b5l', target='DNA pellet')\nincubate(container='clean tube', temperature='room temperature', duration='at least 15 minutes', purpose='rehydrate')\nadd(container='clean tube', reagent='LongLife\u2122 RNase', volume='1\u00b5l per 100\u00b5l TE Buffer', optional=True)\n\n### MANUAL SECTION ###\n# MANUAL: store (container: clean tube, reagent: DNA, temperature: 4\u00b0C, other: {'long_term_storage': ['-20\u00b0C', '-80\u00b0C']})",
