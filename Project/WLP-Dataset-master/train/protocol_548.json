    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: grind (reagent: plant tissue, temperature: liquid nitrogen, other: {'state': 'to fine powder'})\n\n### AUTOMATED SECTION ###\nadd(reagent='Lysis Buffer', volume='appropriate volume', to='ground plant tissue')\n\n### MANUAL SECTION ###\n# MANUAL: add (container: microcentrifuge tube, reagent: finely ground dried tissue, frozen tissue or fresh leaf tissue, volume: 50-100mg, other: {'to': 'tube containing 500\u00b5l Genomic Lysis Buffer'})\n\n### AUTOMATED SECTION ###\nadd(container='microcentrifuge tube', reagent='Genomic Lysis Buffer', volume='500\u00b5l')\nvortex(container='microcentrifuge tube', duration='5 seconds', condition='if ground')\n\n### MANUAL SECTION ###\n# MANUAL: homogenize (container: microcentrifuge tube, other: {'method': 'microfuge pestle', 'strokes': '30-60', 'condition': 'if unground'})\n\n### AUTOMATED SECTION ###\nincubate(container='microcentrifuge tube', reagent='sample', temperature='65\u00b0C', duration='60 minutes', mixing='periodic inversions')\ncool(container='microcentrifuge tube', reagent='sample', temperature='room temperature')\nadd(container='microcentrifuge tube', reagent='chloroform', volume='200\u00b5l')\nmix(container='microcentrifuge tube', method='inverting tube several times')\ncentrifuge(container='microcentrifuge tube', duration='10 minutes', speed='14,000xg')\nremove(container='microcentrifuge tube', reagent='upper phase', to='clean microcentrifuge tube')\nadd(container='microcentrifuge tube', reagent='DNA Stripping Solution', volume='50\u00b5l')\nmix(container='microcentrifuge tube', method='invert several times')\nincubate(container='microcentrifuge tube', reagent='sample', temperature='60\u00b0C', duration='5-10 minutes')\nadd(container='microcentrifuge tube', reagent='Precipitation Solution', volume='100\u00b5l')\nmix(container='microcentrifuge tube', method='invert several times')\ncentrifuge(container='microcentrifuge tube', duration='5 minutes', speed='14,000xg')\ntransfer(container='clean tube', reagent='supernatant')\nadd(container='clean tube', reagent='isopropanol', volume='500\u00b5l', purpose='precipitate genomic DNA')\ninvert(container='tube', times='10', purpose='precipitate DNA')\nadd(container='tube', reagent='Mussel Glycogen', volume='2\u00b5l', purpose='DNA carrier', optional=True)\ncentrifuge(container='tube', duration='5 minutes', speed='14,000xg', purpose='pellet genomic DNA')\nremove(container='tube', reagent='supernatant')\nadd(container='tube', reagent='70% ethanol', volume='700\u00b5l', purpose='wash DNA pellet')\ninvert(container='tube', times='several', purpose='wash DNA pellet')\ncentrifuge(container='tube', duration='1 minute', speed='14,000xg')\nremove(container='tube', reagent='ethanol wash', method='decant or pipette')\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: tube, duration: several minutes, other: {'surface': 'clean absorbent', 'purpose': 'drain excess ethanol'})\n\n### AUTOMATED SECTION ###\nadd(container='tube', reagent='TE Buffer', volume='50\u00b5l', to='pellet')\nincubate(container='tube', temperature='room temperature', duration='at least 15 minutes', purpose='rehydrate')\nadd(container='tube', reagent='LongLife RNase', volume='1\u00b5l per 100\u00b5l TE Buffer', optional=True)\n\n### MANUAL SECTION ###\n# MANUAL: store (container: tube, reagent: DNA, temperature: 4\u00b0C (short term), -20\u00b0C or -80\u00b0C (long term))",
