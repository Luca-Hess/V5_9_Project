    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\ninvert(container='tube', purpose='mix')\nincubate(container='tube', temperature='room temperature', duration='2-3 minutes')\ncentrifuge(container='tube', duration='5 minutes', speed='2,000xg')\nremove(container='tube', reagent='supernatant', note='carefully without disturbing the pellet')\nadd(container='tube', reagent='RBC Lysis Buffer', volume='10ml', target='pellet')\nmix(container='tube')\ncentrifuge(container='tube', duration='5 minutes', speed='2,000xg')\nremove(container='tube', reagent='supernatant')\nrepeat(steps='add RBC Lysis Buffer, mix, centrifuge, remove supernatant', condition='if pellet is not white')\nvortex(container='tube', purpose='resuspend cells in residual liquid')\nadd(container='tube', reagent='XIT\u2122 Lysis Buffer', volume='4ml', target='resuspended cells')\nvortex(container='tube', speed='vigorously', purpose='lyse cells')\nincubate(container='tube', temperature='37\u00b0C', duration='5-10 minutes or until solution is homogenous', condition='if cell clumps are visible after mixing')\nadd(container='tube', reagent='XIT\u2122 Protein Precipitation Buffer', volume='900\u00b5l', target='sample')\nmix(container='tube', method='invert tube 10-20 times')\ncentrifuge(container='tube', duration='5 minutes', speed='2,000g')\ntransfer(container='new tube', reagent='supernatant', note='carefully')\nadd(container='tube', reagent='isopropanol', volume='4ml', target='supernatant')\nmix(container='tube', method='invert sample 20-25 times')\ncentrifuge(container='tube', duration='5 minutes', speed='2,000g')\ndiscard(container='tube', reagent='supernatant')\nremove(container='tube', reagent='remaining liquid', method='use pipette', note='carefully without disturbing DNA pellet')\nadd(container='tube', reagent='70% ethanol', volume='2ml', target='pellet')\ninvert(container='tube', times='twice', purpose='wash pellet')\ncentrifuge(container='tube', duration='3 minutes', speed='2,000g')\ndiscard(container='tube', reagent='supernatant')\n\n### MANUAL SECTION ###\n# MANUAL: drain (container: tube, other: {'method': 'on clean absorbent paper'})\n\n### AUTOMATED SECTION ###\nair dry(container='tube', duration='15 minutes')\nadd(container='tube', reagent='TE buffer', volume='500\u00b5l', purpose='dissolve DNA')\nincubate(container='tube', temperature='55-65\u00b0C', duration='1 hour', purpose='rehydrate genomic DNA')\nincubate(container='tube', temperature='room temperature', duration='overnight', purpose='ensure complete genomic DNA hydration')\nstore(container='tube', reagent='DNA', temperature='4\u00b0C (short term), -20\u00b0C or -80\u00b0C (long term)')\nadd(container='15ml centrifuge tube', reagent='whole blood', volume='5ml', preloaded='5ml RBC Lysis Buffer')",
