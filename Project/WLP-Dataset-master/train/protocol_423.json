    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\nadd(container='plastic centrifuge bottle', reagent='phage lysate', volume='100-150 ml')\nadd(container='plastic centrifuge bottle', reagent='RNase', volume='10 \u00b5l per 100 ml lysate, 15 \u00b5l per 150 ml lysate')\nincubate(container='plastic centrifuge bottle', temperature='room temperature', duration='30 min')\nadd(container='plastic centrifuge bottle', reagent='NaCl', volume='6.5 g per 100 ml lysate', final_concentration='1M')\nincubate(container='plastic centrifuge bottle', temperature='on ice', duration='1 hour')\ncentrifuge(container='plastic centrifuge bottle', duration='10 min', speed='11,000xg (8,300 rpm on GSA rotor)')\ntransfer(container='new bottle', reagent='supernatant')\nadd(container='new bottle', reagent='PEG 8000', volume='10 g per 100 ml lysate', final_concentration='100 g/l')\nshake(container='new bottle', purpose='to mix')\nincubate(container='new bottle', temperature='on ice', duration='1 hour')\ncentrifuge(container='new bottle', duration='10 min', speed='10,000xg (7,835 rpm on GSA rotor)')\n\n### MANUAL SECTION ###\n# MANUAL: discard (container: new bottle, reagent: supernatant, other: {})\n# MANUAL: drain (container: new bottle, other: {'method': 'set bottle upside down on paper towels/Kimwipes'})\n\n### AUTOMATED SECTION ###\nrinse(container='new bottle', reagent='SM buffer', volume='1-2 ml (twice)')\ncollect(container='2 ml microcentrifuge tubes', volume='1 ml per bottle')\nshake(container='resin container', reagent='resin', purpose='to resuspend')\nheat(container='TE solution', reagent='TE', temperature='80\u00b0C')\nadd(container='2 ml microcentrifuge tube', reagent='resin', volume='1 ml')\nmix(container='2 ml microcentrifuge tube', method='by inversion')\n\n### MANUAL SECTION ###\n# MANUAL: attach (container: column, other: {'to': '3 ml syringe'})\n# MANUAL: push (container: column, reagent: sample, volume: 1 ml at a time, other: {})\n# MANUAL: push (container: column, reagent: 80% isopropanol, volume: 2 ml (1 ml at a time), other: {})\n# MANUAL: place (container: column, other: {'location': 'original 2 ml tube'})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='column in 2 ml tube', duration='2 min', speed='10,000xg', purpose='remove excess isopropanol')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: column, other: {'location': 'new 1.5 ml microcentrifuge tube'})\n\n### AUTOMATED SECTION ###\nadd(container='1.5 ml microcentrifuge tube', reagent='warm TE', volume='100 \u00b5l', temperature='warm', purpose='to elute')\nvortex(container='1.5 ml microcentrifuge tube', duration='briefly')\ncentrifuge(container='1.5 ml microcentrifuge tube', duration='30 sec', speed='10,000xg')\n\n### MANUAL SECTION ###\n# MANUAL: check (reagent: isolated DNA, other: {'method': 'NanoDrop'})\n# MANUAL: validate (reagent: isolated DNA, other: {'method': 'Quant IT DNA quantification'})",
