    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: puncture (other: {'tool': 'dissecting scissors, fine forceps, or .22 gauge needle', 'sample': 'posterior end of staged pupa'})\n\n### AUTOMATED SECTION ###\nplace(container='Eppendorf tube', reagent='FAAG', volume='500 ul', sample='punctured pupa')\nstore(container='Eppendorf tube', temperature='4 degrees Celsius', duration='overnight', sample='pupa in FAAG')\nremove(container='Eppendorf tube', reagent='FAAG', location='hood')\n\n### MANUAL SECTION ###\n# MANUAL: dispose (container: \"Aldehyde Waste\" container, reagent: FAAG)\n\n### AUTOMATED SECTION ###\ndehydrate(container='Eppendorf tube', reagent='ethanol series', series=['80% Ethanol', '85% Ethanol', '90% Ethanol', '100% Ethanol'], volume_per_step='500 ul')\nclear(container='Eppendorf tube', reagent='Xylenes')\nrotate(container='Eppendorf tube', temperature='room temperature', device='nutator')\ndehydrate(container='Eppendorf tube', reagent='80% Ethanol', volume='500 ul')\ndehydrate(container='Eppendorf tube', reagent='85% Ethanol', volume='500 ul')\ndehydrate(container='Eppendorf tube', reagent='90% Ethanol', volume='500 ul')\ndehydrate(container='Eppendorf tube', reagent='100% Ethanol', volume='500 ul')\nreplace(container='Eppendorf tube', reagent='100% Ethanol', volume='500 ul', with='500 ul Xylenes', duration='30 minutes')\n\n### MANUAL SECTION ###\n# MANUAL: dispose (container: \"Aldehyde Waste\" container, reagent: Xylenes)\n\n### AUTOMATED SECTION ###\nremove(container='Eppendorf tube', reagent='Xylenes')\nreplace(container='Eppendorf tube', reagent='Xylenes', volume='500 ul', duration='30 minutes', repeat='3 times')\n\n### MANUAL SECTION ###\n# MANUAL: transfer (container: scintillation vial, reagent: Xylenes, volume: 2 ml, other: {'sample': 'pupae', 'tool': 'designated paintbrush'})\n# MANUAL: mark (container: scintillation vial, other: {'level': 'Xylenes'})\n\n### AUTOMATED SECTION ###\nadd(container='scintillation vial', reagent='paraffin chips (paraplast xtra)', amount='~20 chips')\nmelt(container='scintillation vial', reagent='paraffin chips', temperature='42 degrees Celsius', device='incubator')\nleave(container='scintillation vial', duration='overnight')\nadd(container='500 ml beaker', reagent='melted paraffin')\nincubate(container='500 ml beaker', reagent='melted paraffin', temperature='56 degrees Celsius', duration='until use tomorrow')\n\n### MANUAL SECTION ###\n# MANUAL: remove (container: glass vial, reagent: Xylenes/Wax, other: {'place': 'wax waste tray'})\n\n### AUTOMATED SECTION ###\nadd(container='glass vial', reagent='melted paraffin', volume='small amount', temperature='56 degrees Celsius', purpose='dilute residual Xylene')\n\n### MANUAL SECTION ###\n# MANUAL: remove (container: glass vial, reagent: diluted paraffin/Xylene, other: {'place': 'wax waste tray'})\n\n### AUTOMATED SECTION ###\nadd(container='glass vial', reagent='melted paraffin', temperature='56 degrees Celsius')\nincubate(container='glass vial', reagent='paraffin', temperature='56 degrees Celsius', duration='1-2 hours')\nremove(container='glass vial', reagent='paraffin')\nreplace(container='glass vial', reagent='fresh melted paraffin', temperature='56 degrees Celsius', duration='1-2 hours')\nremove(container='glass vial', reagent='paraffin')\nreplace(container='glass vial', reagent='fresh melted paraffin', temperature='56 degrees Celsius', fill_to_top=True)\nincubate(container='glass vial', reagent='paraffin', duration='overnight')\n\n### MANUAL SECTION ###\n# MANUAL: make (container: index cards (mold), other: {'method': 'taping ends and sides'})\n\n### AUTOMATED SECTION ###\npre-heat(container='hot block', temperature='56 degrees Celsius', cover='tin foil')\nswirl(container='vial', sample='pupae')\n\n### MANUAL SECTION ###\n# MANUAL: pour (container: mold on hot block, reagent: wax and pupae)\n# MANUAL: orient (container: mold, reagent: samples, other: {'before': 'wax