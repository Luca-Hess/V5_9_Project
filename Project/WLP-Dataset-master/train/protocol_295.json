ge(reagent=\"Weigert's Hematoxylin\", duration='5 minutes', sample='slides')\n\n### MANUAL SECTION ###\n# MANUAL: rinse (reagent: running tap water, duration: 5 minutes, other: {'sample': 'slides'})\n\n### AUTOMATED SECTION ###\nsubmerge(reagent='Pollak Trichrome', duration='7 minutes', sample='slides')\nrinse(reagent='distilled water', duration='10 seconds', purpose='remove bulk of stain', sample='slides')\nsubmerge(reagent='acidified distilled water', duration='10 seconds', sample='slides')\ndip(reagent='70% Ethanol', sample='slides', times='3')\ndip(container='container 1', reagent='95% Ethanol', sample='slides', times='3')\nsubmerge(container='container 2', reagent='95% Ethanol', duration='3 minutes', sample='slides')\nsubmerge(container='container 1', reagent='100% Ethanol', duration='3 minutes', sample='slides')\nsubmerge(container='container 2', reagent='100% Ethanol', duration='3 minutes', sample='slides')\nsubmerge(container='container 1', reagent='Xylenes', duration='3 minutes', sample='slides')\nsubmerge(container='container 2', reagent='Xylenes', duration='3 minutes', sample='slides')\n\n### MANUAL SECTION ###\n# MANUAL: remove (reagent: slides from Xylenes, other: {'drain': '2 minutes on paper towel'})\n\n### AUTOMATED SECTION ###\napply(reagent='Permount', volume='78 ul', coverslip='large')\nlet harden(container='slides', duration='overnight')",
