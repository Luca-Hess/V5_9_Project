    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: start (container: 50ml tube, reagent: CSM, volume: 10ml, other: {'cell culture': True})\n\n### AUTOMATED SECTION ###\ngrow(container='50ml tube', temperature='30\u00b0C', duration='8-10 hours', speed='shaker')\n\n### MANUAL SECTION ###\n# MANUAL: measure (other: {'OD': True})\n\n### AUTOMATED SECTION ###\ndilute(container='250ml glass flask', reagent='CSM', volume='45ml', duration='overnight', starting=True)\ntransfer(container='50ml falcon tube')\nadd(container='50ml falcon tube', reagent='Formaldehyde', volume='5ml')\ninvert(container='50ml falcon tube', duration='a few times')\nincubate(container='50ml falcon tube', temperature='benchtop (ambient)', duration='45min')\ncentrifuge(container='50ml falcon tube', duration='4min', speed='3,000rpm')\n\n### MANUAL SECTION ###\n# MANUAL: decant (container: 50ml falcon tube, other: {})\n\n### AUTOMATED SECTION ###\nwash(container='50ml falcon tube', reagent='BufferB (ice-cold)', volume='1ml', temperature='ice-cold')\ntransfer(container='1.5ml tube')\ncentrifuge(container='1.5ml tube', duration='4min', speed='3,000rpm')\nwash(container='1.5ml tube', reagent='BufferB (ice-cold)', volume='1ml', temperature='ice-cold')\ncentrifuge(container='1.5ml tube', duration='4min', speed='3,000rpm')\n\n### MANUAL SECTION ###\n# MANUAL: decant (container: 1.5ml tube, other: {})\n\n### AUTOMATED SECTION ###\nresuspend(container='1.5ml tube', reagent='BufferB', volume='1ml')\nadd(container='1.5ml tube', reagent='Zymolyase', volume='2.5ul')\ndigest(container='1.5ml tube', temperature='30\u00b0C', duration='until most cells turn dark')\n\n### MANUAL SECTION ###\n# MANUAL: drop (container: glass slide, reagent: cells, volume: 1\u03bcL, other: {'do not cover': True})\n# MANUAL: check (container: glass slide, reagent: cells, duration: every 30 minutes, other: {'phase contrast microscope': True, '20x scope': True})\n\n### AUTOMATED SECTION ###\nwash(container='1.5ml tube', reagent='BufferB (ice-cold)', volume='1ml', temperature='ice-cold')\ncentrifuge(container='1.5ml tube', duration='5-6min', speed='2,000rpm')\n\n### MANUAL SECTION ###\n# MANUAL: decant (container: 1.5ml tube, other: {})\n\n### AUTOMATED SECTION ###\nwash(container='1.5ml tube', reagent='BufferB (ice-cold)', volume='1ml', temperature='ice-cold')\ncentrifuge(container='1.5ml tube', duration='5-6min', speed='2,000rpm')\nresuspend(container='1.5ml tube', reagent='70% Ethanol', volume='1ml', duration='overnight', store at 4\u00b0C=True)",
