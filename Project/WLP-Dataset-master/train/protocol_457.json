    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\ntransfer(container='1.5ml microfuge tube', reagent='cells (1-5x10^6, suspension or trypsinized)')\nadd(container='1.5ml microfuge tube', reagent='Genomic Lysis Buffer', volume='500\u00b5l')\nincubate(container='sample', temperature='55-60\u00b0C', duration='15 minutes')\nadd(container='sample', reagent='Proteinase K solution', volume='1\u00b5l per 100\u00b5l Lysis Buffer')\nincubate(container='sample', temperature='60\u00b0C', duration='1-2 hours')\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: tube, duration: periodically each hour, other: {})\n\n### AUTOMATED SECTION ###\ncool(container='sample', temperature='room temperature')\nadd(container='sample', reagent='chloroform', volume='200\u00b5l')\nmix(container='tube', speed='invert several times')\ncentrifuge(container='tube', duration='10 minutes', speed='14,000xg')\nremove(container='tube', reagent='upper phase', destination='clean microcentrifuge tube')\nadd(container='sample', reagent='DNA Stripping Solution', volume='50\u00b5l')\nmix(container='tube', speed='invert several times')\nincubate(container='sample', temperature='60\u00b0C', duration='5-10 minutes')\nadd(container='sample', reagent='Precipitation Solution', volume='100\u00b5l')\nmix(container='tube', speed='invert several times')\ncentrifuge(container='sample', duration='5 minutes', speed='14,000xg')\ntransfer(container='clean tube', reagent='supernatant')\nadd(container='clean tube', reagent='isopropanol', volume='500\u00b5l', purpose='precipitate genomic DNA')\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: tube, speed: 10 times, other: {'purpose': 'precipitate DNA'})\n\n### AUTOMATED SECTION ###\nadd(container='tube', reagent='Mussel Glycogen', volume='2\u00b5l', purpose='DNA carrier')\ncentrifuge(container='tube', duration='5 minutes', speed='14,000xg', purpose='pellet genomic DNA')\nremove(container='tube', reagent='supernatant')\nadd(container='tube', reagent='70% ethanol', volume='700\u00b5l', purpose='wash DNA pellet')\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: tube, speed: several times, other: {'purpose': 'wash DNA pellet'})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='tube', duration='1 minute', speed='14,000xg')\nremove(container='tube', reagent='ethanol wash')\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: tube, duration: several minutes, other: {'purpose': 'drain excess ethanol'})\n\n### AUTOMATED SECTION ###\nadd(container='tube', reagent='TE Buffer', volume='50\u00b5l', purpose='rehydrate DNA pellet')\nincubate(container='tube', temperature='room temperature', duration='at least 15 minutes', purpose='rehydrate DNA')\nadd(container='tube', reagent='LongLife\u2122 RNase', volume='1\u00b5l per 100\u00b5l TE Buffer')\nstore(container='tube', reagent='DNA', temperature='4\u00b0C (short term), -20\u00b0C or -80\u00b0C (long term)')",
