    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\nfilter(container='glass fiber pre-filter (Gelman A/E), 0.22 \u03bcm pore size membrane (Durapore, Millipore)', reagent='natural seawater sample', volume='15-20 liters')\nconcentrate(container='30 kD MWC Spiral Cartridge Concentrator (SCC)', reagent='filtered seawater', volume='to ca. 150-200 ml')\ntransfer(container='Centriprep 30\u2019s', reagent='SCC retentate')\nstore(reagent='balance of concentrate', temperature='refrigerator')\ncentrifuge(container='IEC-HN SE II', reagent='Centriprep 30\u2019s', temperature='refrigerator if possible', duration='15 minutes', speed='full speed')\n\n### MANUAL SECTION ###\n# MANUAL: empty (container: central reservoir, other: {'without_refilling': True})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='IEC-HN SE II', reagent='Centriprep 30\u2019s', temperature='refrigerator if possible', duration='15 minutes', speed='full speed', repeat=True)\n\n### MANUAL SECTION ###\n# MANUAL: empty (container: central reservoir, other: {})\n# MANUAL: refill (container: central reservoir, volume: keeping volumes equal, other: {'maximize_filtration_area': True, 'balance_rotor': True})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='Centripreps', continue_until_no_more_water_enters_central_chamber=True)\n\n### MANUAL SECTION ###\n# MANUAL: remove (container: central insert from 2 units, other: {})\n# MANUAL: replace (container: caps, other: {})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='retentate chamber', duration='briefly', recover_droplets_from_sides=True)\ncombine(container='2 Centriprep units, then one Centriprep unit', reagent='retentate', by_gentle_pipetting=True)\nspin(container='final Centriprep unit', volume='ca. 500 \u03bcl (final volume)')\nmake(reagent='1% agarose gel (1 g Bio-Rad Molecular Grade Agarose + 99 ml 0.5x TBE)', volume='100 ml', heat_until_clear=True)\n\n### MANUAL SECTION ###\n# MANUAL: assemble (container: mold with backing plate, other: {})\n\n### AUTOMATED SECTION ###\npour(container='mold', reagent='liquid agarose gel')\nset(container='mold', reagent='agarose gel')\nfill(container='electrophoresis chamber', reagent='0.5x TBE', volume='2 liters')\nturn_on(container='pump and chiller')\nset(container='chiller', temperature='14\u00b0C')\n\n### MANUAL SECTION ###\n# MANUAL: remove (container: comb and sides of mold, other: {})\n# MANUAL: slide (container: backing plate with gel, other: {'out_of_mold': True})\n# MANUAL: place (container: electrophoresis chamber receiver, reagent: gel with backing plate, other: {'wells_in_rear': True})\n\n### AUTOMATED SECTION ###\nchill(container='electrophoresis chamber', reagent='gel')\ntransfer(container='Microcons (30 or 100 kD MWC)', reagent='aliquots')\nspin(container='Microcon', reagent='aliquot', duration='20 minutes', speed='1000 x g (about 4000 RPM in Eppendorf Microfuge)', to_near_dryness=True)\n\n### MANUAL SECTION ###\n# MANUAL: remove (container: Microcon, reagent: smaller volume aliquots, other: {'as_they_reach_proper_volume': True})\n\n### AUTOMATED SECTION ###\nstore(container='refrigerator', reagent='smaller volume aliquots')\nadd(container='each tube', reagent='50 \u03bcl 1:10 TE', volume='50 \u03bcl', do_not_touch_membrane_with_pipette_tip=True)\nspin(container='each tube', reduce_volume_as_above=True)\nrepeat(step=22)\nrepeat(step=22)\nadd(container='membrane', reagent='20 \u03bcl 0.5x TBE', volume='20 \u03bcl', to_elute_viruses=True, do_not_touch_membrane=True)\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: cartridge, other: {'place_in_fresh_tube': True})\n\n### AUTOMATED SECTION ###\nspin(container='fresh tube', duration='5 minutes', speed='1000 x g', to_recover=True)\nplace(container='water bath', reagent='tubes containing recovered viruses', temperature='60\u00b0C', duration='10 minutes')\n\n### MANUAL SECTION ###\n# MANUAL: remove (container: water bath, reagent: tubes, other: {})\n\n### AUTOMATED SECTION ###\nplace(container='ice', reagent='tubes', duration='2 minutes')\ntransfer(container='microfuge', reagent='tubes')\nspin(container='microfuge', reagent='tubes', duration='briefly', recover_condensation_from_walls=True)\nprepare(reagent='molecular weight markers (100-200 ng marker stock + 0.5x TBE to 20 \u03bcl)', volume='20 \u03bcl')\nadd(container='each tube', reagent='10 \u03bcl PFGE loading buffer', volume='10 \u03bcl')\nmix(container='each tube', invert_several_times_slowly=True, roll_between_fingers=True)\nturn_off(container='chiller and pump')\nload(container='gel', reagent='samples')\nturn_on(container='pump')\nturn_on(container='chiller')\n\n### MANUAL SECTION ###\n# MANUAL: close (container: lid, other: {})\n# MANUAL: check (container: connections, other: {'all_in_order': True})\n\n### AUTOMATED SECTION ###\nset(speed='6V', voltage='6V')\nset(initial_switch_time='1s')\nset(final_switch_time='10s')\nset(duration='18h', run_time='18h')\nstart()\n\n### MANUAL SECTION ###\n# MANUAL: check (temperature: 14-16\u00b0C, duration: after 10 minutes, other: {'timer_running_down': True})",
