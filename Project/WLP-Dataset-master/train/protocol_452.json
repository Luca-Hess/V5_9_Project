    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: remove (container: -20\u00b0C freezer, reagent: 10,000x SYBR-Gold and Anti-fade solutions, temperature: -20\u00b0C, other: {})\n# MANUAL: keep (reagent: SYBR-Gold, other: {'condition': 'in the dark'})\n# MANUAL: prepare (reagent: dilutions of sample, other: {})\n\n### AUTOMATED SECTION ###\nmix(container='tube', reagent='sample dilution', method='invert up and down')\ndilute(reagent='SYBR-Gold', volume='5 \u03bcl SYBR-Gold in 45 \u03bcl TE', ratio='1:10')\ndispense(container='coverslip', reagent='Anti-fade', volume='10 \u03bcl', form='drop')\npipette(container='petri dish (top and bottom halves)', reagent='diluted SYBR-Gold', volume='2.5 \u03bcl per half (2 drops per dish)')\nadd(container='petri dish', reagent='TE', volume='97.5 \u03bcl')\npipette(container='frosted support (top)', reagent='water')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: tower support, reagent: backing filter, other: {})\n\n### AUTOMATED SECTION ###\nopen(container='vacuum', purpose='evenly lay down filter')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: backing filter, reagent: water, volume: drop, other: {})\n# MANUAL: place (container: filter, reagent: 25 mm 0.02 \u03bcm Anodisc filter, other: {})\n\n### AUTOMATED SECTION ###\nturn on(container='vacuum')\npipette(container='filter', reagent='sample', tip position='very close to filter')\ndry(container='filter', duration='30 sec')\n\n### MANUAL SECTION ###\n# MANUAL: remove (container: filter, other: {'condition': 'vacuum still running'})\n# MANUAL: place (container: petri dish, reagent: filter, other: {'location': 'on drop of SYBR'})\n\n### AUTOMATED SECTION ###\nstain(container='petri dish', reagent='filter', duration='15 min')\nplace(container='backing filter', reagent='water', volume='0.5 ml')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: water droplet, reagent: stained filter, other: {})\n\n### AUTOMATED SECTION ###\nturn on(container='vacuum', duration='30 sec', purpose='dry filter')\n\n### MANUAL SECTION ###\n# MANUAL: remove (container: filter, other: {'condition': 'vacuum still on'})\n# MANUAL: place (container: slide, reagent: filter and coverslip with anti-fade, other: {})\n# MANUAL: tape (container: slide, other: {'location': 'one end'})\n# MANUAL: put (container: slide, reagent: 2 coverslips, other: {})\n# MANUAL: tape (container: slide, other: {'location': 'middle to hold down coverslips'})\n# MANUAL: examine (other: {'timing': 'immediately'})\n# MANUAL: freeze (container: freezer, reagent: slide, duration: 1 hr, other: {'purpose': 'improve staining'})",
