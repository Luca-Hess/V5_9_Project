    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: grow (reagent: DH5alpha E. coli cells with pSP64 poly(A) plasmid, duration: overnight, other: {})\n# MANUAL: miniprep (reagent: plasmids, other: {})\n# MANUAL: quantify (reagent: plasmids, other: {})\n\n### AUTOMATED SECTION ###\nset up(reagent='digestion reaction', volume='50ul', buffer='1x EcoRI compatible buffer', plasmid='~3ug pSP64-NSERT-poly(A)', enzyme='5ul EcoRI')\nincubate(reagent='digestion reaction', temperature='37C', duration='2 hours')\n\n### MANUAL SECTION ###\n# MANUAL: save (reagent: plasmid, other: {'purpose': 'for gel below'})\n# MANUAL: pour (reagent: 1% agarose gel, other: {})\n# MANUAL: run (container: agarose gel, reagent: digest and undigested plasmid, volume: ~100ng, other: {'purpose': 'to check for cutting'})\n\n### AUTOMATED SECTION ###\nclean up(reagent='digestion reactions', kit='PCR clean up kit', pooling='pool repeats of same plasmid digest')\n\n### MANUAL SECTION ###\n# MANUAL: quantify (reagent: cleaned up plasmid, other: {'instrument': 'nanodrop'})\n\n### AUTOMATED SECTION ###\nset up(reagent='SP6 reaction master mix', components=[{'name': 'Txn optimized 5x buffer', 'volume': '4ul'}, {'name': 'DTT (100mM)', 'volume': '2ul'}, {'name': 'Recombinant RNasin', 'volume': '0.75ul'}, {'name': '10mM rATP', 'volume': '1ul'}, {'name': '10mM rUTP', 'volume': '1ul'}, {'name': '10mM rCTP', 'volume': '1ul'}, {'name': '10mM rGTP', 'volume': '1ul'}, {'name': '4tUTP (10mM)', 'volume': '2ul'}, {'name': 'SP6 RNA Polymerase', 'volume': '1ul'}])\nmake(container='new tubes', reagent='linearized plasmid DNA', volume='6.25ul')\ndilute(reagent='provided standard', volume='1ul standard + 5.25ul water', purpose='kit positive control')\nadd(container='tube of linearized DNA', reagent='SP6 reaction master mix', volume='13.75ul')\nincubate(container='water bath', reagent='SP6 reaction', temperature='30/37C', duration='1-2hr')\nremove(container='PCR tubes', reagent='reaction mixture', volume='2ul', purpose='for later gel')\nadd(container='reaction', reagent='Ampure XP beads', volume='40ul')\nmix(container='reaction', reagent='Ampure XP beads and reaction mixture', method='pipette')\nwait(temperature='RT', duration='5min')\nadd(container='beads', reagent='80% etOH', volume='~500ul')\nwait(duration='~30 seconds')\naspirate(container='beads', reagent='supernatant', volume='all')\n\n### MANUAL SECTION ###\n# MANUAL: dry (container: rack with kimwipe over open tubes, reagent: beads, temperature: RT, duration: 10min, other: {})\n\n### AUTOMATED SECTION ###\nresuspend(container='beads', reagent='hyclone H_2O', volume='20ul')\n\n### MANUAL SECTION ###\n# MANUAL: run (container: 1% agarose TAE gel, reagent: sample, volume: ~3ul, duration: 20min, other: {'voltage': '100V', 'ladder': 'NEB 1kb ladder'})\n# MANUAL: visualize (container: gel, reagent: dye (sybrsafe), other: {})\n# MANUAL: quantify (reagent: sample, other: {'instrument': 'qubit'})\n\n### AUTOMATED SECTION ###\ndilute(reagent='sample')\nadd(container='rest of sample', reagent='RQ1 RNase-Free DNase', volume='1ul')\nincubate(reagent='reaction', temperature='37C', duration='15min')\ncollect(container='magnetic rack', reagent='beads', purpose='move beads to side')\naspirate(container='beads', reagent='supernatant', volume='all')\nadd(container='beads', reagent='80% etOH', volume='~500ul')\nwait(duration='~30 seconds')\naspirate(container='beads', reagent='supernatant', volume='all', note='small tip may help')",
