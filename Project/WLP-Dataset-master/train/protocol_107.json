    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: thaw (container: competent cell aliquots, reagent: competent E.coli cells, volume: appropriate amount, temperature: on ice, other: {})\n\n### AUTOMATED SECTION ###\npre-chill(container='1.5 ml microcentrifuge tubes', volume='required number', temperature='on ice')\npipette(container='pre-chilled 1.5 ml microcentrifuge tubes', reagent='competent E.coli cells', volume='50 \u00b5l')\nadd(container='each tube', reagent='ligation reaction mix or pure plasmid DNA', volume='5-10 \u00b5l (ligation mix) or 5 ng (plasmid DNA)')\nmix(container='each tube', speed='gently')\nincubate(container='tubes', temperature='on ice', duration='30 min')\nheat shock(container='tubes', reagent='cells', temperature='42\u00b0C', duration='45 sec')\nincubate(container='tubes', temperature='on ice', duration='at least 2 min')\nadd(container='each tube', reagent='SOC medium', volume='800 \u00b5l')\nincubate(container='each tube', temperature='37\u00b0C', duration='1 hour')\ntransfer(container='1.5 ml microcentrifuge tubes', reagent='cultures')\ncentrifuge(container='1.5 ml microcentrifuge tubes', duration='1 min', speed='6000 rpm')\nremove(container='1.5 ml microcentrifuge tubes', reagent='supernatant', volume='800 \u00b5l')\nresuspend(container='1.5 ml microcentrifuge tubes', reagent='pellet')\n\n### MANUAL SECTION ###\n# MANUAL: plate (container: LB agar plate, reagent: suspension, other: {'antibiotic': 'appropriate'})\n\n### AUTOMATED SECTION ###\nincubate(container='plates', temperature='37\u00b0C', duration='overnight')",
