    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\nadd(container='2 mL RNAse free eppendorf tube', reagent='Trizol', volume='1000 \u00b5L', sample='50-100 mg parasite tissues')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: 2 mL eppendorf tube, reagent: parasite tissues, other: {'labelled': True})\n# MANUAL: add (container: 2 mL eppendorf tube, reagent: metal bead)\n\n### AUTOMATED SECTION ###\nplace(container='2 mL eppendorf tube', equipment='TissueLyzer')\nrun(container='TissueLyzer', duration='3 minutes', speed='30 Hz')\ncentrifuge(container='2 mL eppendorf tube', temperature='4\u00b0C', duration='10 minutes', speed='12,000 x g')\n\n### MANUAL SECTION ###\n# MANUAL: discard (container: 2 mL eppendorf tube, reagent: top layer of liquid (fatty acids))\n\n### AUTOMATED SECTION ###\ntransfer(container='new labelled 2 mL eppendorf tube', reagent='supernatant')\nincubate(container='2 mL eppendorf tube', temperature='room temperature', duration='5 minutes')\nadd(container='2 mL eppendorf tube', reagent='chloroform', volume='200 \u00b5L')\nmix(container='2 mL eppendorf tube', duration='1 minute', method='invert tubes up and down')\ncentrifuge(container='2 mL eppendorf tube', temperature='4\u00b0C', duration='15 minutes', speed='12,000 x g')\n\n### MANUAL SECTION ###\n# MANUAL: transfer (container: new 2 mL eppendorf tube, reagent: aqueous phase (supernatant), other: {'precaution': True})\n\n### AUTOMATED SECTION ###\nadd(container='2 mL eppendorf tube', reagent='RNAse free isopropanol (100%)', volume='500 \u00b5L')\nmix(container='2 mL eppendorf tube', method='thoroughly')\nincubate(container='2 mL eppendorf tube', temperature='room temperature', duration='15 minutes')\ncentrifuge(container='2 mL eppendorf tube', temperature='4\u00b0C', duration='10 minutes', speed='12,000 x g')\n\n### MANUAL SECTION ###\n# MANUAL: discard (container: 2 mL eppendorf tube, reagent: supernatant)\n\n### AUTOMATED SECTION ###\nadd(container='2 mL eppendorf tube', reagent='75% ethanol (kept cold at -20\u00b0C)', volume='1000 \u00b5L', temperature='-20\u00b0C')\nvortex(container='2 mL eppendorf tube', method='thoroughly')\ncentrifuge(container='2 mL eppendorf tube', temperature='4\u00b0C', duration='5 minutes', speed='7500 x g')\n\n### MANUAL SECTION ###\n# MANUAL: discard (container: 2 mL eppendorf tube, reagent: supernatant)\n# MANUAL: dry (container: 2 mL eppendorf tube, duration: 5-10 minutes, other: {'cap': 'opened'})\n\n### AUTOMATED SECTION ###\nadd(container='2 mL eppendorf tube', reagent='DEPC treated water', volume='20-50 \u00b5L')\nincubate(container='2 mL eppendorf tube', temperature='65\u00b0C', duration='1 minute')\nvortex(container='2 mL eppendorf tube', method='thoroughly')\n\n### MANUAL SECTION ###\n# MANUAL: repeat (container: 2 mL eppendorf tube, other: {'step': '19', 'until': 'RNA is completely dissolved'})",
