    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\nwash(container='embryo wash basket', reagent='embryo wash solution', source='apple juice agar plate', tool='small paintbrush')\npour(container='small tray with wash basket', reagent='household bleach', coverage='until embryos completely covered')\nincubate(container='wash basket in tray', reagent='household bleach', duration='3 minutes', purpose='remove chorion')\nrinse(container='wash basket and embryos')\ntransfer(container='container with 50:50 4% paraformaldehyde and heptane', reagent='embryos')\nshake(container='container with embryos, 4% paraformaldehyde and heptane', duration='20 minutes', speed='150 rpm', device='orbital rotator')\n\n### MANUAL SECTION ###\n# MANUAL: separate (container: container with heptane and PFA solution, other: {'phases': 'heptane and PFA'})\n\n### AUTOMATED SECTION ###\nremove(container='container with separated phases', reagent='bottom phase (PFA)', dispose='as required')\nadd(container='container with remaining heptane', reagent='methanol', volume='equal volume to remaining heptane')\nshake(container='container with embryos, heptane, methanol', duration='20 seconds', speed='vigorous')\n\n### MANUAL SECTION ###\n# MANUAL: settle (container: container with embryos, other: {'purpose': 'allow embryos to settle to bottom'})\n\n### AUTOMATED SECTION ###\nremove(container='container with embryos, heptane, methanol', reagent='heptane (top layer) and most of the methanol')\nadd(container='container with embryos', reagent='methanol', repeat='two more times')\nremove(container='container with embryos', reagent='methanol', repeat='two more times')\ntransfer(container='disposable culture tubes (flint glass)', reagent='embryos in methanol')\n\n### MANUAL SECTION ###\n# MANUAL: settle (container: culture tubes with embryos)\n\n### AUTOMATED SECTION ###\nremove(container='culture tubes', reagent='methanol', do not disturb='embryos at bottom')