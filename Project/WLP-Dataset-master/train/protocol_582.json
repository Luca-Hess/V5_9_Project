    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: seed (reagent: cells, other: {'target_confluency': '70-90%', 'day': 'day of transfection'})\n\n### AUTOMATED SECTION ###\nset up(reagent='RNP formation reaction', volume='7 \u00b5l total', components=[{'name': 'Resuspension Buffer R', 'volume': '5.8 \u00b5l'}, {'name': 'EnGen Cas9-NLS (20 \u00b5M)', 'volume': '0.6 \u00b5l'}, {'name': 'sgRNA (20 \u00b5M)', 'volume': '0.6 \u00b5l'}])\nmix(reagent='RNP reaction', volume='7 \u00b5l', speed='gentle')\nincubate(reagent='RNP reaction', volume='7 \u00b5l', temperature='room temperature', duration='20 minutes')\n\n### MANUAL SECTION ###\n# MANUAL: trypsinize (reagent: cells, other: {})\n\n### AUTOMATED SECTION ###\nwash(reagent='cells', purpose='remove traces of trypsin')\n\n### MANUAL SECTION ###\n# MANUAL: remove (container: sterile microfuge tube, reagent: cells, volume: 1-2 x 10^6 cells, other: {})\n\n### AUTOMATED SECTION ###\nresuspend(reagent='cells', volume='10 ml', buffer='media')\n\n### MANUAL SECTION ###\n# MANUAL: count (reagent: cells, other: {})\n\n### AUTOMATED SECTION ###\ncentrifuge(reagent='cells', duration='5 min', speed='500 x g')\nwash(reagent='cells', volume='1X PBS', times='once')\nresuspend(reagent='cells', volume='50 \u00b5l', buffer='Resuspension Buffer R')\nprepare(container='24-well plate', reagent='growth medium', volume='500 \u00b5l per well', number_of_wells='appropriate')\nadd(container='RNP reaction', reagent='cells', volume='5 \u00b5l', to='each 7 \u00b5l RNP reaction')\naspirate(container='Neon tip', reagent='RNP/cells mix', volume='10 \u00b5l')\n\n### MANUAL SECTION ###\n# MANUAL: electroporate (reagent: cells, duration: 20 ms, other: {'voltage': '1700V', 'pulses': '1'})\n\n### AUTOMATED SECTION ###\ntransfer(container='24-well plate', reagent='cells', from='Neon tip')\nincubate(container='24-well plate', reagent='cells', temperature='37\u00b0C, 5% CO2, humidified', duration='48-72 hours')\naspirate(reagent='media', speed='gentle', from='cells')\nadd(reagent='Epicentre QuickExtract DNA Extraction Solution', volume='75 \u00b5l', to='cells')\nshake(duration='5 minutes', alternative='vortex')\ntransfer(container='PCR plate or tubes', reagent='solution')\nincubate(container='thermocycler', temperature='65\u00b0C', duration='15 min', step='1')\nincubate(container='thermocycler', temperature='95\u00b0C', duration='15 min', step='2')\nincubate(container='thermocycler', temperature='4\u00b0C', duration='hold', step='3')\ndilute(reagent='DNA', volume='1:10', diluent='nuclease-free water')\n\n### MANUAL SECTION ###\n# MANUAL: follow (reagent: EnGen Mutation Detection Kit (E3321S), other: {'manual': 'protocol'})\n\n### AUTOMATED SECTION ###\ncentrifuge(duration='5 min', speed='500 x g')\nwash(reagent='1X PBS', volume='100 \u00b5l', wash_number='1/2')\nwash(reagent='1X PBS', volume='100 \u00b5l', wash_number='2/2')",
