iner='2 mL freezer vial', reagent='starter culture', volume='850 uL', add='150 uL sterilized 100% glycerol')\nmix(container='freezer vial', speed='thoroughly')\nstore(container='freezer vial', temperature='-80 \u00b0C')\ndilute(container='starter culture', reagent='LB-Amp', volume='1/500 to 1/1000', destination='larger volume')\ngrow(container='culture', temperature='37\u00b0C', duration='12-16 hours', speed='300 rpm')\n\n### MANUAL SECTION ###\n# MANUAL: harvest (container: culture, other: {})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='culture', temperature='4\u00b0C', duration='15 min', speed='6000 x g')\n\n### MANUAL SECTION ###\n# MANUAL: discard (container: tube, reagent: supernatant, other: {})\n# MANUAL: recover (container: tube, reagent: plasmid DNA, other: {'method': 'commercial plasmid mini-prep'})\n\n### AUTOMATED SECTION ###\ncombine(container='PCR tube', reagent=['12.8 uL Nuclease-free water', '2.00 uL NEBuffer 4 (10X)', '0.20 uL BSA (100X)', '4.00 uL Plasmid DNA (0.5 ug/uL)'], order='listed')\nincubate(container='PCR tube', reagent='mixture', temperature='37 \u00b0C', duration='1 hour', device='thermocycler')\nincubate(container='PCR tube', reagent='mixture', temperature='65 \u00b0C', duration='20 minutes', purpose='enzyme inactivation')\nadd(container='PCR tube', reagent='TE buffer', volume='to bring to 100 uL')\nadd(container='PCR tube', reagent='Phenol:Chloroform:Isoamyl alcohol (25:24:1)', volume='100 uL')\nvortex(container='PCR tube')\ncentrifuge(container='PCR tube', duration='5 minutes', speed='11,000 rpm')\ntransfer(container='new tube', reagent='aqueous phase')\nadd(container='tube', reagent='3M Sodium Acetate', volume='0.1 volumes (10 uL)')\nadd(container='tube', reagent='Isopropanol', volume='0.7 volumes (70 uL)')\nmix(container='tube')\nincubate(container='tube', temperature='room temperature', duration='10 minutes')\ncentrifuge(container='tube', temperature='4\u00b0C', duration='30 minutes', speed='11,000 rpm')\n\n### MANUAL SECTION ###\n# MANUAL: discard (container: tube, reagent: supernatant, other: {})\n\n### AUTOMATED SECTION ###\nwash(container='tube', reagent='ice cold 70% ethanol', volume='200 uL')\ncentrifuge(container='tube', duration='5 minutes')\n\n### MANUAL SECTION ###\n# MANUAL: air dry (container: tube, reagent: pellet, other: {})\n\n### AUTOMATED SECTION ###\nresuspend(container='tube', reagent='nuclease-free water', volume='5 uL')\ntransfer(container='new tube', reagent='linearized plasmid prep', volume='2 uL')\nadd(container='tube', reagent='sterile water', volume='2 uL', destination='2 uL sample')\n\n### MANUAL SECTION ###\n# MANUAL: check (reagent: diluted sample, volume: 1 uL, other: {'purpose': 'concentration of plasmid prep'})\n# MANUAL: run (container: 1% agarose gel, reagent: diluted plasmid prep, volume: 3 uL, other: {'purpose': 'check for complete digestion'})\n\n### AUTOMATED SECTION ###\ncombine(container='tube', reagent='Ambion MEGAscript T7 kit components', temperature='room temperature')\n\n### MANUAL SECTION ###\n# MANUAL: mix (container: tube, speed: thoroughly, other: {'method': 'flick'})\n\n### AUTOMATED SECTION ###\nincubate(container='tube', reagent='mixture', temperature='37\u00b0C', duration='16 hours')\nadd(container='tube', reagent='Turbo DNase', volume='1 uL', to='concentration')\nincubate(container='tube', temperature='37\u00b0C', duration='15 minutes')\n\n### MANUAL SECTION ###\n# MANUAL: extract (container: tube, reagent: citrate-saturated (pH 4.7) phenol:chloroform:isoamyl alcohol (25:24:1), volume: 1 volume, other: {})\n\n### AUTOMATED SECTION ###\nvortex(container='tube', duration='1 minute')\ncentrifuge(container='tube', duration='2 minutes', speed='12,000 x g')\ntransfer(container='fresh tube', reagent='upper, aqueous phase')\nadd(container='tube', reagent='chloroform:isoamyl alcohol (24:1)', volume='1 volume')\nvortex(container='tube', duration='1 minute')\ncentrifuge(container='tube', duration='2 minutes', speed='12,000 x g')\ntransfer(con