    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: place (container: PFA vial, reagent: filter (marine particle sample), other: {'orientation': 'sample side facing downwards or folded inwards'})\n\n### AUTOMATED SECTION ###\nadd(container='PFA vial', reagent='sulfuric acid', volume='1.5 mL', targets='all samples and blanks')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: PFA vial, reagent: lid, other: {'lid_position': 'atop loosely'})\n\n### AUTOMATED SECTION ###\nincubate(container='PFA vial', reagent='filter in sulfuric acid', temperature='room temperature', duration='20 min', lid_position='loosely placed')\n\n### MANUAL SECTION ###\n# MANUAL: lift (container: PFA vial, reagent: lid, other: {'purpose': 'to add hydrogen peroxide'})\n\n### AUTOMATED SECTION ###\nadd(container='PFA vial', reagent='hydrogen peroxide', volume='0.5 mL')\nmix(container='PFA vial', speed='gentle swirl')\nincubate(container='PFA vial', temperature='110\u02daC', duration='60 min', device='hot plate', lid_position='loosely placed')\nadd(container='PFA vial', reagent='hydrogen peroxide', volume='0.5 mL')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: PFA vial, reagent: cap, other: {'lid_position': 'loosely'})\n\n### AUTOMATED SECTION ###\nheat(container='PFA vial', temperature='200\u02daC', device='hot plate')\ncool(container='PFA vial', temperature='room temperature', condition='if undissolved filter pieces or viscous material persist')\nadd(container='PFA vial', reagent='hydrogen peroxide', volume='100-200 \u00b5L aliquots', condition='to digest undissolved material')\ndry(container='PFA vial', temperature='235-250\u02daC')\ncool(container='PFA vial', condition='if small droplet of sulfuric acid remains')\nsuspend(container='PFA vial', reagent='Milli-Q water or 8N nitric acid', volume='small aliquot', condition='if small droplet of sulfuric acid remains')\ndry(container='PFA vial', temperature='235\u02daC', repeat='until droplet is removed')\nresuspend(container='PFA vial', reagent='mixture of HNO3, HCl, HF acids (4M each) in Milli-Q water', volume='2 mL', mixture='freshly prepared')\nheat(container='PFA vial', temperature='100-110\u02daC', duration='4 hours')\ncool(container='PFA vial', temperature='room temperature')\n\n### MANUAL SECTION ###\n# MANUAL: uncover (container: PFA vial)\n\n### AUTOMATED SECTION ###\ndry(container='PFA vial', temperature='100-110\u02daC', duration='overnight')\nadd(container='PFA vial', reagent='50% HNO3/15% H2O2 (v/v)', volume='2 mL', mixture='freshly prepared')\ndry(container='PFA vial', temperature='100-110\u02daC', device='hotplate')\nresuspend(container='PFA vial', reagent='50% HNO3/15% H2O2 (v/v)', volume='200-500 \u00b5L')\n\n### MANUAL SECTION ###\n# MANUAL: cap (container: PFA vial, other: {'lid_position': 'loosely'})\n\n### AUTOMATED SECTION ###\nheat(container='PFA vial', temperature='110\u02daC')\n\n### MANUAL SECTION ###\n# MANUAL: uncover (container: PFA vial, other: {'condition': 'after vigorous bubbling ceases'})\n\n### AUTOMATED SECTION ###\ndry(container='PFA vial', temperature='135\u02daC')\nadd(container='PFA vial', reagent='concentrated HNO3', volume='100 \u00b5L')\nheat(container='PFA vial', temperature='110\u02daC', purpose='to dryness')\nredissolve(container='PFA vial', reagent='0.1 M HNO3', volume='1 mL')\ndilute(container='PFA vial', reagent='0.1 M HNO3', volume='to 5% of original concentration', purpose='for analysis')\n\n### MANUAL SECTION ###\n# MANUAL: prepare (other: {'reference': 'Conway et al. (2013)', 'purpose': 'isotopic analysis'})",
