    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\ncool(reagent='all reagents', temperature='0\u00b0C', method='putting on ice')\ndilute(reagent='peptide stock solution', volume='5\u03bcl peptide stock + 120\u03bcl PBS', temperature='on ice', final concentration='400\u03bcM')\ndispense(container='96-well U-bottom plate', reagent='20\u03bcl diluted peptide (400\u03bcM)', volume='20\u03bcl')\ndispense(container='96-well U-bottom plate', reagent='20\u03bcl conditional Flex-T\u2122 monomer (200\u03bcg/mL)', volume='20\u03bcl')\nmix(container='96-well U-bottom plate', method='pipetting up and down')\n\n### MANUAL SECTION ###\n# MANUAL: seal (container: 96-well U-bottom plate)\n\n### AUTOMATED SECTION ###\ncentrifuge(container='96-well U-bottom plate', temperature='4\u00b0C', duration='2 minutes', speed='3300xg', purpose='collect liquid down')\n\n### MANUAL SECTION ###\n# MANUAL: unseal (container: 96-well U-bottom plate)\n\n### AUTOMATED SECTION ###\ncool(container='96-well U-bottom plate', temperature='on ice')\n\n### MANUAL SECTION ###\n# MANUAL: illuminate (container: 96-well U-bottom plate, duration: 30 minutes, other: {'distance': '2-5 cm', 'light': 'UV'})\n# MANUAL: seal (container: 96-well U-bottom plate)\n\n### AUTOMATED SECTION ###\nincubate(container='96-well U-bottom plate', temperature='37\u00b0C', duration='30 minutes', condition='in the dark')\ntransfer(container='new plate', reagent='peptide-exchanged monomer', volume='30\u03bcl')\ndispense(container='new plate', reagent='conjugated streptavidin', volume='3.3\u03bcl')\nmix(container='new plate', method='pipetting up and down')\nincubate(container='new plate', temperature='on ice', duration='30 minutes', condition='in the dark')\ndispense(reagent='50mM D-Biotin', volume='1.6\u03bcl', destination='PBS')\ndispense(reagent='10% (w/v) NaN3', volume='6\u03bcl', destination='PBS')\ndispense(reagent='PBS', volume='192.4\u03bcl', destination='blocking solution')\nmix(reagent='blocking solution', method='vortexing')\ndispense(reagent='blocking solution', volume='2.4\u03bcl', destination='reaction mixture')\nmix(method='pipetting up and down')\n\n### MANUAL SECTION ###\n# MANUAL: seal ()\n\n### AUTOMATED SECTION ###\nincubate(temperature='2-8\u00b0C or on ice', duration='overnight or 30 minutes', condition='in the dark')\ncentrifuge(container='plate', temperature='4\u00b0C', duration='5 minutes', speed='3300xg')\ncool(container='plate', temperature='on ice', condition='in the dark')\ndispense(container='96-well U-bottom plate or 12 x 75 mm tubes', reagent='cells', volume='2 x 10^6 cells')\nadjust(container='96-well U-bottom plate or 12 x 75 mm tubes', reagent='CellStaining Buffer', volume='to 200\u03bcl')\ndispense(reagent='Flex-T\u2122 complex', volume='2\u03bcl per sample')\nmix()\nincubate(temperature='on ice', duration='30 minutes', condition='in the dark')\ndispense(reagent='antibody cocktail', volume='optimal concentration')\nincubate(temperature='on ice', duration='30 minutes', condition='in the dark')\nwash(reagent='Staining Buffer', times='two')\nresuspend(reagent='Staining Buffer')\n\n### MANUAL SECTION ###\n# MANUAL: acquire (reagent: samples, duration: within 2 hours, other: {'instrument': 'flow cytometer', 'settings': 'appropriate'})",
