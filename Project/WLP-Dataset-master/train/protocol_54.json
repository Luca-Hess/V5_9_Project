    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: blot (other: {'material': 'tissue', 'tool': 'clean absorbent paper', 'target': 'excess fixative'})\n# MANUAL: add (container: microcentrifuge tube, reagent: ground frozen tissue or fresh tissue, volume: 5-10mg)\n\n### AUTOMATED SECTION ###\nadd(container='microcentrifuge tube', reagent='Genomic Lysis Buffer', volume='500\u00b5l')\nincubate(container='microcentrifuge tube', temperature='55-65\u00b0C', duration='15 minutes', purpose='soften tissue')\n\n### MANUAL SECTION ###\n# MANUAL: homogenize (container: microcentrifuge tube, reagent: sample, other: {'tool': 'microfuge pestle', 'strokes': '30-60'})\n\n### AUTOMATED SECTION ###\nincubate(container='microcentrifuge tube', reagent='sample', temperature='55-60\u00b0C', duration='15-60 minutes')\nadd(container='microcentrifuge tube', reagent='Proteinase K solution', volume='1\u00b5l per 100\u00b5l Lysis Buffer', optional=True)\nincubate(container='microcentrifuge tube', reagent='sample', temperature='60\u00b0C', duration='1-2 hours', optional=True)\ninvert(container='microcentrifuge tube', reagent='sample', duration='periodically each hour')\ncool(container='microcentrifuge tube', reagent='sample', temperature='room temperature')\nadd(container='microcentrifuge tube', reagent='chloroform', volume='200\u00b5l')\nmix(container='microcentrifuge tube', reagent='sample + chloroform', method='invert several times')\ncentrifuge(container='microcentrifuge tube', reagent='sample', duration='10 minutes', speed='14,000xg')\nremove(container='microcentrifuge tube', reagent='upper phase', destination='clean microcentrifuge tube')\nadd(container='microcentrifuge tube', reagent='DNA Stripping Solution', volume='50\u00b5l')\nmix(container='microcentrifuge tube', reagent='sample + DNA Stripping Solution', method='invert several times')\nincubate(container='microcentrifuge tube', reagent='sample', temperature='60\u00b0C', duration='5-10 minutes')\nadd(container='microcentrifuge tube', reagent='Precipitation Solution', volume='100\u00b5l')\nmix(container='microcentrifuge tube', reagent='sample + Precipitation Solution', method='invert several times')\ncentrifuge(container='microcentrifuge tube', reagent='sample', duration='5 minutes', speed='14,000xg')\ntransfer(container='clean tube', reagent='supernatant')\nadd(container='clean tube', reagent='isopropanol', volume='500\u00b5l', purpose='precipitate genomic DNA')\ninvert(container='tube', reagent='sample', times='10', purpose='precipitate DNA')\nadd(container='tube', reagent='Mussel Glycogen', volume='2\u00b5l', optional=True, purpose='DNA carrier')\ncentrifuge(container='tube', reagent='sample', duration='5 minutes', speed='14,000xg', purpose='pellet genomic DNA')\nremove(container='tube', reagent='supernatant')\nadd(container='tube', reagent='70% ethanol', volume='700\u00b5l', purpose='wash DNA pellet')\ninvert(container='tube', reagent='sample', method='invert several times', purpose='wash DNA pellet')\ncentrifuge(container='tube', reagent='sample', duration='1 minute', speed='14,000xg')\n\n### MANUAL SECTION ###\n# MANUAL: decant (container: tube, reagent: ethanol wash)\n\n### AUTOMATED SECTION ###\npipette(container='tube', reagent='ethanol wash')\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: tube, duration: several minutes, other: {'surface': 'clean absorbent surface', 'purpose': 'drain excess ethanol'})\n\n### AUTOMATED SECTION ###\nadd(container='tube', reagent='TE Buffer', volume='50\u00b5l', target='DNA pellet')\nincubate(container='tube', reagent='DNA pellet + TE Buffer', temperature='room temperature', duration='at least 15 minutes', purpose='rehydrate')\nadd(container='tube', reagent='LongLife\u2122 RNase', volume='1\u00b5l per 100\u00b5l TE Buffer', optional=True)\nstore(container='tube', reagent='DNA', temperature='4\u00b0C (short term), -20\u00b0C or -80\u00b0C (long term)')",
