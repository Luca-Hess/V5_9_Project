    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\nincubate(reagent='Buffer ATL and Buffer AL', temperature='56 C', duration='5 minutes')\ntransfer(container='2ml deep well (autoclaved)', reagent='broth culture', volume='250 ul')\ncentrifuge(container='plate', duration='15 min', speed='4063 x g', cell_count='maximum 2 x 10^9 cells')\ndiscard(reagent='supernatant')\nresuspend(reagent='pellet in Buffer ATL', volume='200 ul', mixing_method='pipetting up and down 15 times')\nseal(seal_type='foil')\nincubate(temperature='56 C', duration='1 hour', location='oven')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: extra plate, other: {'purpose': 'prevent foil from coming off'})\n\n### AUTOMATED SECTION ###\nmix(method='pipette up and down 15 times')\ncentrifuge()\n\n### MANUAL SECTION ###\n# MANUAL: freeze (temperature: -80 C, other: {})\n# MANUAL: thaw (other: {})\n\n### AUTOMATED SECTION ###\ncentrifuge(duration='1 min', speed='1000g')\nadd(reagent='Buffer AL', volume='205 ul')\nadd(reagent='molecular grade EtOH', volume='205 ul')\nmix(method='pipette up and down 15 times')\ncentrifuge()\n\n### MANUAL SECTION ###\n# MANUAL: place (container: DNeasy 96 plates, other: {'location': 'on top of 2ml deep well plate'})\n# MANUAL: mark (container: DNeasy 96 plates, other: {'purpose': 'sample identification'})\n\n### AUTOMATED SECTION ###\ntransfer(container='DNeasy 96 plates', reagent='lysate', volume='approximately 600 ul', source='step 7')\nseal(container='DNeasy 96 plate', seal_type='porous film')\ncentrifuge(container='DNeasy 96 plate', duration='15 min', speed='4063g')\ncentrifuge(container='DNeasy 96 plate', duration='10 min', speed='4063g', condition='if lysate remains')\nadd(container='DNeasy 96 plate', reagent='Buffer AW1', volume='500 ul')\nseal(container='DNeasy 96 plate', seal_type='AirPore Tape Sheet')\ncentrifuge(container='DNeasy 96 plate', duration='5 min', speed='4063g')\nremove(container='DNeasy 96 plate', seal_type='AirPore Tape')\nadd(container='DNeasy 96 plate', reagent='Buffer AW2', volume='500 ul')\ncentrifuge(container='DNeasy 96 plate', duration='15 min', speed='4063g')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: DNeasy 96 plate, other: {'location': 'new collection rack (2ml deep well plate)'})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='DNeasy 96 plate', duration='15 min', speed='4063g')\n\n### MANUAL SECTION ###\n# MANUAL: place (container: DNeasy 96 plate, other: {'location': 'new rack of VWR 500ul plate', 'orientation': 'correct'})\n\n### AUTOMATED SECTION ###\nadd(container='DNeasy 96 plate', reagent='Buffer TE', volume='200 ul', purpose='elute DNA')\nseal(container='DNeasy 96 plate')\nincubate(container='DNeasy 96 plate', temperature='room temp', duration='1 minute')\ncentrifuge(container='DNeasy 96 plate', duration='4 min', speed='4063g')\nadd(container='DNeasy 96 plate', reagent='Buffer TE', volume='200 ul', purpose='repeat for maximum DNA yield')\naliquot(container='green 96 microplate', reagent='extracted DNA', volume='20 ul')\nseal(container='DNeasy 96 plate and 96 microplate', seal_type='non-sterile foil')\n\n### MANUAL SECTION ###\n# MANUAL: freeze (container: DNeasy 96 plate, temperature: -80 C, other: {})\n# MANUAL: freeze (container: 96 microplate, temperature: -20 C, other: {})",
