    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: perform (temperature: room temperature, other: {'assay_type': 'Non-Interfering\u2122 (NI) Protein Assay'})\n# MANUAL: use (container: 2ml tubes)\n# MANUAL: prepare (container: 2ml tubes, reagent: BSA or Non-Animal Protein Standard, volume: as indicated in table, other: {'table': {'Tube #': [1, 2, 3, 4, 5, 6], 'Protein Standard [2mg/ml] (\u00b5l)': [0, 4, 8, 12, 20, 25], 'Protein (\u00b5g)': [0, 8, 16, 24, 40, 50]}})\n\n### AUTOMATED SECTION ###\nadd(container='2ml tubes', reagent='protein samples', volume='1-50\u00b5l')\nadd(container='2ml tubes', reagent='UPPA\u2122 I', volume='0.5ml')\nvortex(container='2ml tubes')\nincubate(container='2ml tubes', temperature='room temperature', duration='2-3 minutes')\nadd(container='2ml tubes', reagent='UPPA\u2122 II', volume='0.5ml')\nvortex(container='2ml tubes')\ncentrifuge(container='2ml tubes', duration='5 minutes', speed='maximum speed (~10,000xg)', purpose='pellet precipitated protein')\n\n### MANUAL SECTION ###\n# MANUAL: decant (container: 2ml tubes, reagent: supernatant)\n\n### AUTOMATED SECTION ###\ncentrifuge(container='2ml tubes', duration='quick pulse', speed='maximum speed (~10,000xg)', purpose='spin down residual liquid')\nremove(container='2ml tubes', reagent='residual liquid', method='pipette')\nadd(container='2ml tubes', reagent='Copper Solution (Reagent I)', volume='100\u00b5l')\nadd(container='2ml tubes', reagent='deionized water', volume='400\u00b5l')\nvortex(container='2ml tubes', duration='until pellet dissolves', target='protein precipitate pellet')\ndispense(container='2ml tubes', reagent='Reagent II', volume='1ml', speed='rapidly', method='1ml pipette', target='tube containing Reagent I plus DI Water')\nmix(container='2ml tubes', duration='immediately', method='inverting tubes')\nincubate(container='2ml tubes', temperature='room temperature', duration='15-20 minutes')\n\n### MANUAL SECTION ###\n# MANUAL: read (container: 2ml tubes, other: {'wavelength': '480nm', 'reference': 'DI water'})\n# MANUAL: plot (other: {'x': 'protein concentration', 'y': 'absorbance'})\n# MANUAL: determine (other: {'target': 'protein concentrations of unknowns'})",
