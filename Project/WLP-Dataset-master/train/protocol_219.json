    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\nadd(container='1.5ml microfuge tube', reagent='body fluid', volume='50\u00b5l')\nadd(container='1.5ml microfuge tube', reagent='Genomic Lysis Buffer', volume='250\u00b5l', condition='normal protein concentration')\nmix(container='1.5ml microfuge tube', method='pipetting up and down', condition='normal protein concentration')\nadd(container='1.5ml microfuge tube', reagent='Genomic Lysis Buffer', volume='550\u00b5l', condition='high protein concentration')\nmix(container='1.5ml microfuge tube', method='pipetting up and down', condition='high protein concentration')\nincubate(container='1.5ml microfuge tube', temperature='55-60\u00b0C', duration='15 minutes')\nadd(container='1.5ml microfuge tube', reagent='Proteinase K solution', volume='1\u00b5l per 100\u00b5l Lysis Buffer', optional=True)\nincubate(container='1.5ml microfuge tube', temperature='60\u00b0C', duration='1-2 hours', optional=True)\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: 1.5ml microfuge tube, other: {'frequency': 'periodically each hour', 'optional': True})\n\n### AUTOMATED SECTION ###\ncool(container='1.5ml microfuge tube', temperature='room temperature')\nadd(container='1.5ml microfuge tube', reagent='chloroform', volume='200\u00b5l')\nmix(container='1.5ml microfuge tube', method='inverting tube several times')\ncentrifuge(container='1.5ml microfuge tube', duration='10 minutes', speed='14,000xg')\nremove(container='1.5ml microfuge tube', reagent='upper phase', destination='clean microcentrifuge tube')\nadd(container='clean microcentrifuge tube', reagent='DNA Stripping Solution', volume='50\u00b5l')\nmix(container='clean microcentrifuge tube', method='invert several times')\nincubate(container='clean microcentrifuge tube', temperature='60\u00b0C', duration='5-10 minutes')\nadd(container='clean microcentrifuge tube', reagent='Precipitation Solution', volume='100\u00b5l')\nmix(container='clean microcentrifuge tube', method='invert several times')\ncentrifuge(container='clean microcentrifuge tube', duration='5 minutes', speed='14,000xg')\ntransfer(container='clean microcentrifuge tube', reagent='supernatant', destination='clean tube')\nadd(container='clean tube', reagent='isopropanol', volume='500\u00b5l', purpose='precipitate genomic DNA')\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: clean tube, other: {'times': '10', 'purpose': 'precipitate DNA'})\n\n### AUTOMATED SECTION ###\nadd(container='clean tube', reagent='Mussel Glycogen', volume='2\u00b5l', optional=True, purpose='DNA carrier')\ncentrifuge(container='clean tube', duration='5 minutes', speed='14,000xg', purpose='pellet genomic DNA')\nremove(container='clean tube', reagent='supernatant')\nadd(container='clean tube', reagent='70% ethanol', volume='700\u00b5l', purpose='wash DNA pellet')\nmix(container='clean tube', method='invert several times')\ncentrifuge(container='clean tube', duration='1 minute', speed='14,000xg')\nremove(container='clean tube', reagent='ethanol wash', method='decant or pipette off')\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: clean tube, duration: several minutes, other: {'surface': 'clean absorbent surface', 'purpose': 'drain excess ethanol'})\n\n### AUTOMATED SECTION ###\nadd(container='clean tube', reagent='TE Buffer', volume='50\u00b5l', target='DNA pellet')\nincubate(container='clean tube', temperature='room temperature', duration='at least 15 minutes', purpose='rehydrate')\nadd(container='clean tube', reagent='LongLife\u2122 RNase', volume='1\u00b5l per 100\u00b5l TE Buffer', optional=True)\n\n### MANUAL SECTION ###\n# MANUAL: store (container: clean tube, reagent: DNA, temperature: 4\u00b0C, other: {'long_term': ['-20\u00b0C', '-80\u00b0C']})",
