rd(container='centrifuge tube', reagent='supernatant')\nresuspend(container='centrifuge tube', reagent='staining buffer', volume='to achieve 1 x 10^7 cells/ml')\naliquot(container='tube', reagent='cell suspension', volume='100 \u03bcl per tube')\npipette(container='tube', reagent='anti-BrdU antibody', volume='appropriate concentration (not specified)')\nincubate(container='tube', reagent='cells + anti-BrdU antibody', temperature='room temperature', duration='20 minutes')\nwash(container='cells', reagent='Cell Staining Buffer (Cat. No. 420201)')\ncentrifuge(container='cells', duration='5 minutes', speed='1200-1500 rpm (200-300 x g)')\npipette(container='tube', reagent='7-AAD or DAPI', volume='1 \u03bcg', Cat. No.='7-AAD (Cat. No. 420403) or DAPI (Cat. No. 422801)')\nwait(duration='5 minutes', purpose='prior to acquiring samples on flow cytometer')",
