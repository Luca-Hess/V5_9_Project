    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: prepare (reagent: SOB medium, other: {})\n# MANUAL: prepare (reagent: SOC medium (SOB media supplemented with 20mM glucose), other: {})\n# MANUAL: prepare (reagent: TFB buffer, other: {})\n# MANUAL: prepare (reagent: DTT solution, other: {})\n# MANUAL: grow (reagent: host cells in SOB media, volume: 5 mL, temperature: 37\u00b0C, duration: overnight, other: {})\n# MANUAL: inoculate (reagent: SOB medium with overnight culture, volume: 40 mL SOB medium, 0.8 mL overnight culture, other: {})\n# MANUAL: grow (reagent: inoculated SOB medium, temperature: 37\u00b0C, duration: 3-4 hours, other: {'A550': '0.45-0.55'})\n\n### AUTOMATED SECTION ###\ncentrifuge(reagent='cells', temperature='4\u00b0C', duration='5 min', speed='5,000 rpm', rotor='Sorvall SS34')\n\n### MANUAL SECTION ###\n# MANUAL: discard (reagent: supernatant, other: {})\n\n### AUTOMATED SECTION ###\nresuspend(reagent='pellet with TFB solution', volume='12.5 mL')\n\n### MANUAL SECTION ###\n# MANUAL: hold (reagent: TFB solution, volume: 2.5 mL, other: {'purpose': 'for use later'})\n\n### AUTOMATED SECTION ###\nchill(reagent='cells', temperature='on ice', duration='15 min')\ncentrifuge(reagent='cells', temperature='4\u00b0C', duration='5 min', speed='5,000 rpm', rotor='Sorvall SS34')\n\n### MANUAL SECTION ###\n# MANUAL: discard (reagent: supernatant, other: {})\n\n### AUTOMATED SECTION ###\nresuspend(reagent='pellet with TFB solution', volume='2.4 mL')\nadd(reagent='DMSO', volume='84 \u00b5L', final_concentration='3.5%')\nmix()\nchill(reagent='cells', temperature='on ice', duration='5 min')\nadd(reagent='DTT solution', volume='84 \u00b5L', final_concentration='75 mM')\nmix()\nchill(reagent='cells', temperature='on ice', duration='10 min')\nadd(reagent='DMSO', volume='84 \u00b5L', final_concentration='same as before')\nmix()\nchill(reagent='cells', temperature='on ice', duration='5 min')\npipette(container='prechilled microfuge tube', reagent='competent cells', volume='21 \u00b5L')\nadd(container='microfuge tube', reagent='DNA', volume='1-2 \u00b5L', note='in as small a volume as possible')\nmix(container='microfuge tube')\nchill(container='microfuge tube', reagent='cells + DNA', temperature='on ice', duration='30 min')\nheat(container='microfuge tube', reagent='cells + DNA', temperature='42\u00b0C', duration='3 min', method='heat pulse')\nadd(container='microfuge tube', reagent='SOC medium', volume='80 \u00b5L')\nincubate(container='microfuge tube', reagent='cells + DNA + SOC medium', temperature='37\u00b0C', duration='60 min')\n\n### MANUAL SECTION ###\n# MANUAL: spread (container: plate, reagent: transformed cells, volume: 100 \u00b5L, other: {})\n\n### AUTOMATED SECTION ###\nincubate(container='plate', reagent='transformed cells', temperature='37\u00b0C', duration='overnight')\nchill(container='plate', temperature='on ice', duration='2 min')",
