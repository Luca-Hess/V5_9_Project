    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\npipette(container='1.7-mL screw cap tubes', reagent='amplified 0.22-\u00b5m filtered virus stock', volume='1.7 mL')\n\n### MANUAL SECTION ###\n# MANUAL: float (container: microcentrifuge tubes in long ultracentrifuge tubes (14 \u00d7 95 mm), reagent: water, other: {'flush_with_top': True})\n# MANUAL: balance (container: ultracentrifuge tubes, other: {'balance_within': '1 g'})\n# MANUAL: load (container: ultracentrifuge tubes into SW40 rotor, other: {})\n\n### AUTOMATED SECTION ###\ncentrifuge(container='SW40 rotor (ultracentrifuge tubes)', duration='1 h', speed='133,000g')\n\n### MANUAL SECTION ###\n# MANUAL: recover (container: microcentrifuge tubes, other: {})\n\n### AUTOMATED SECTION ###\nremove(container='microcentrifuge tubes', reagent='supernatant')\nresuspend(container='microcentrifuge tubes', reagent='pellet')\n\n### MANUAL SECTION ###\n# MANUAL: thaw (reagent: SYBR Green I, other: {})\n\n### AUTOMATED SECTION ###\nadd(container='concentrated virus tube', reagent='SYBR Green I stain', volume='1 \u00b5L')\nincubate(container='concentrated virus tube', duration='15 min', light_condition='dark')\npipette(container='microscope slide', reagent='suspension', volume='1 \u00b5L')\n\n### MANUAL SECTION ###\n# MANUAL: add (container: microscope slide, reagent: 18 \u00d7 18 mm coverslip, other: {})\n# MANUAL: observe (container: microscope slide, other: {'instrument': 'epifluorescence microscope'})\n\n### AUTOMATED SECTION ###\nadd(container='each tube', reagent='water or seawater medium', volume='1.65 mL')\ncentrifuge(container='each tube', duration='as above (1 h)', speed='as above (133,000g)')\nremove(container='each tube', reagent='supernatant')\nresuspend(container='each tube', reagent='pellet')\n\n### MANUAL SECTION ###\n# MANUAL: repeat (other: {'steps': '10 and 11'})\n# MANUAL: repeat (other: {'steps': '10 and 11'})",
