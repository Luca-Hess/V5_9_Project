d True-Phos\u2122 Perm Buffer', temperature='-20\u00b0C', while_vortexing=True)\npermeabilize(reagent='cells', volume='10 mL per 1 mL whole blood (example)', temperature='-20\u00b0C', buffer='pre-chilled True-Phos\u2122 Perm Buffer')\nincubate(reagent='cells', temperature='-20\u00b0C', duration='60 minutes', purpose='permeabilization')\ncentrifuge(reagent='cells', temperature='room temperature', duration='5 minutes', speed='1000 x g')\ndecant(reagent='supernatant')\nvortex(reagent='cell pellet', purpose='resuspend')\nadd(reagent='Cell Staining Buffer', purpose='wash')\ncentrifuge(reagent='cells', temperature='room temperature', duration='5 minutes', speed='1000 x g')\ndecant(reagent='supernatant')\nrepeat(steps=['add Cell Staining Buffer', 'centrifuge', 'decant'], total_washes=2)\nresuspend(reagent='cells', volume='equivalent to starting volume of blood', buffer='Cell Staining Buffer')\ntransfer(container='12 x 75 mm tube', reagent='resuspended cells', volume='100 uL')\nadd(reagent='antibody cocktail(s)', to_appropriate_tubes=True)\nvortex(reagent='tube contents', purpose='mix')\nincubate(reagent='cells with antibody cocktail', temperature='room temperature', duration='30 minutes', in_dark=True)\nadd(reagent='Cell Staining Buffer', volume='2 mL')\ncentrifuge(reagent='cells', temperature='room temperature', duration='5 minutes', speed='1000 x g')\ndecant(reagent='supernatant')\nrepeat(steps=['add Cell Staining Buffer', 'centrifuge', 'decant'], total_washes=2)\nresuspend(reagent='cells', volume='500 uL', buffer='Cell Staining Buffer')\n\n### MANUAL SECTION ###\n# MANUAL: analyze (reagent: cells, other: {'instrument': 'flow cytometer'})",
