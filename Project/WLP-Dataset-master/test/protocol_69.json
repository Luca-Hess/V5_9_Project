    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\nadd(container='plate', reagent='Trypsin', volume='2ml')\nshake(container='plate', speed='gently')\nadd(reagent='ES medium without LIF', volume='8ml', purpose='inactivate trypsin')\ncentrifuge(duration='10min', speed='500rpm')\nadd(container='10cm petri-dish', reagent='EB medium', volume='8ml', while='centrifuging')\nresuspend(container='pellet', reagent='EB medium', volume='5ml', speed='gently', method='5ml pipette, up and down for 5 times')\ntake(reagent='cell suspension', volume='100ul', dilute_into='1ml')\n\n### MANUAL SECTION ###\n# MANUAL: count (other: {})\n\n### AUTOMATED SECTION ###\ntake(reagent='cells', volume='appropriate number', dilute_to='1\u00d710^6 cells/ml')\nresuspend(volume='5ml', speed='gently', method='5ml pipette, up and down for 4 times')\nseed(container='dish', reagent='cells', volume='2ml', per='dish')\n\n### MANUAL SECTION ###\n# MANUAL: save (reagent: cells, volume: 2\u00d710^6, other: {'purpose': 'RNA extraction'})\n\n### AUTOMATED SECTION ###\ntransfer(container='50ml tubes', reagent='medium containing Ebs')\nadd(container='dishes', reagent='medium', volume='5ml', immediately=True)\nincubate(container='dishes', after_adding_medium=True)\nsink(container='tubes', reagent='cells', duration='5min', method='gravity')\ndiscard(reagent='supernatant')\nadd(container='pellets', reagent='medium', volume='5ml')\nmix(container='samples', speed='gently', method='inverting a few times')\ndistribute(container='different dishes', reagent='samples')\n\n### MANUAL SECTION ###\n# MANUAL: prepare (container: gelatin coated chamber slides (2 well), other: {})\n\n### AUTOMATED SECTION ###\nadd(container='each well', reagent='medium', volume='1.5ml')\ntransfer(container='15ml tube', reagent='1 dish of day4 Ebs')\nwait(container='tube', reagent='Ebs', duration='5min', method='sink by gravity')\ndiscard(reagent='supernatant')\nadd(container='pellets', reagent='EB medium', volume='10ml')\nseed(container='each well', reagent='EB', volume='0.5ml')\nchange(reagent='medium', duration='everyday', steps=['suck supernatant', 'replace with fresh EB medium'])\n\n### MANUAL SECTION ###\n# MANUAL: take (container: 2 wells for each group, other: {'days': ['day6', 'day8', 'day12']})\n\n### AUTOMATED SECTION ###\nsuck(reagent='medium', speed='carefully')\nfix(reagent='4% PFA', temperature='RT', duration='30min', location='in hood')\nwash(reagent='PBS', volume='2ml', wash_number=1)\nwash(reagent='PBS', volume='2ml', wash_number=2)\nwash(reagent='PBS', volume='2ml', wash_number=3)\nstore(reagent='samples in PBS', temperature='4\u00b0C')",
