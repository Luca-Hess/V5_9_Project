    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: perform (temperature: room temperature, other: {'assay_type': 'Non-Interfering Protein Assay', 'format': 'high throughput 96-well'})\n# MANUAL: use (container: 2ml tubes)\n# MANUAL: prepare (container: 2ml tubes, reagent: BSA or Non-Animal Protein Standard, volume: variable (see table), other: {'concentration': '2mg/ml', 'tube_numbers': [1, 2, 3, 4, 5, 6]})\n\n### AUTOMATED SECTION ###\nadd(container='2ml tubes', reagent='protein samples', volume='1-50\u00b5l')\nadd(container='2ml tubes', reagent='UPPA\u2122 I', volume='0.5ml')\nmix(container='2ml tubes', speed='vortex')\nadd(container='2ml tubes', reagent='UPPA\u2122 II', volume='0.5ml')\nmix(container='2ml tubes', speed='vortex')\nincubate(container='2ml tubes', temperature='room temperature', duration='2-3 minutes')\ncentrifuge(container='titer plate', duration='7 minutes', speed='~5,000xg', purpose='pellet precipitate')\n\n### MANUAL SECTION ###\n# MANUAL: invert (container: titer plate, other: {'purpose': 'remove supernatant'})\n\n### AUTOMATED SECTION ###\nshake(container='titer plate', purpose='remove excess supernatant')\nadd(container='2ml tubes', reagent='Copper Solution (Reagent I)', volume='100\u00b5l')\nadd(container='2ml tubes', reagent='deionized water', volume='400\u00b5l')\nmix(container='2ml tubes', speed='vortex until pellet dissolves')\ndispense(container='2ml tubes', reagent='Reagent II', volume='1ml', speed='rapidly', method='shoot directly into tube containing Reagent I plus DI Water')\nmix(container='2ml tubes', speed='invert tubes immediately')\nincubate(container='2ml tubes', temperature='room temperature', duration='15-20 minutes')\n\n### MANUAL SECTION ###\n# MANUAL: read (container: 2ml tubes, other: {'measurement': 'absorbance at 480nm', 'reference': 'against DI water'})\n\n### AUTOMATED SECTION ###\ntransfer(container='from 2ml tubes to 96 well micro titer plate', reagent='assay reaction', volume='200\u00b5l', plate_type='flat bottom')\n\n### MANUAL SECTION ###\n# MANUAL: measure (container: 96 well micro titer plate, other: {'measurement': 'absorbance at 480nm', 'reference': 'against DI water'})\n# MANUAL: plot (other: {'x_axis': 'protein concentration', 'y_axis': 'absorbance'})\n# MANUAL: determine (other: {'output': 'protein concentrations of unknowns'})",
