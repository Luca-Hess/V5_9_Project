trifuge(duration='5 minutes', speed='300 x g')\ndiscard(reagent='supernatant')\nresuspend(reagent='MojoSort\u2122 Buffer', volume='100 \u03bcL or by flicking', cells='pellet after centrifugation')\nvortex(reagent='CD4 Nanobeads', speed='maximum speed, 5 touches', purpose='resuspend')\nadd(reagent='Nanobeads', volume='10 \u03bcL')\nmix()\nincubate(temperature='on ice', duration='15 minutes')\naliquot(reagent='Nanobeads', volume='variable (scale up as needed)', cells='if separating more cells')\naliquot(reagent='Nanobeads', volume='variable (scale down as needed)', cells='if separating less than 1 x 10^7 cells')\nadd(reagent='MojoSort\u2122 Buffer', volume='3 mL')\nplace(container='tube', duration='5 minutes', equipment='magnet')\n\n### MANUAL SECTION ###\n# MANUAL: pour (reagent: liquid)\n# MANUAL: recover (container: tube)\n\n### AUTOMATED SECTION ###\nresuspend(reagent='buffer', volume='appropriate amount', cells='CD4+ T Cells')\n\n### MANUAL SECTION ###\n# MANUAL: repeat (other: {'steps': '10-12', 'times': '2 more times (total 3 magnetic separations)', 'fraction': 'labeled fraction'})\n\n### AUTOMATED SECTION ###\naliquot(reagent='small aliquot', purpose='monitor purity and yield')",
