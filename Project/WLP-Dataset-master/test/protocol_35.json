    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### MANUAL SECTION ###\n# MANUAL: grow (reagent: DH5alpha E. coli cells with pSP64 poly(A) plasmid, duration: overnight, other: {})\n# MANUAL: miniprep (reagent: plasmids, other: {})\n# MANUAL: quantify (reagent: plasmids, other: {})\n\n### AUTOMATED SECTION ###\nset up(reagent='digestion reaction: 50ul 1x EcoRI compatible buffer, ~3ug pSP64-NSERT-poly(A), 5ul EcoRI', volume='50ul buffer, 5ul EcoRI, ~3ug plasmid')\nincubate(reagent='digestion reaction', temperature='37C', duration='2 hours')\n\n### MANUAL SECTION ###\n# MANUAL: save (reagent: some plasmid, other: {'purpose': 'for gel below'})\n# MANUAL: pour (reagent: 1% agarose gel, other: {})\n# MANUAL: run (container: agarose gel, reagent: ~100ng of digest and undigested plasmid, volume: ~100ng, other: {'purpose': 'to check for cutting'})\n# MANUAL: clean up (reagent: digestion reactions, other: {'method': 'PCR clean up kit', 'pooling': 'pool repeats of same plasmid digest'})\n# MANUAL: quantify (reagent: cleaned up reactions, other: {'method': 'nanodrop'})\n\n### AUTOMATED SECTION ###\nset up(reagent='SP6 reaction master mix (kit reagents)', volume='see protocol for volumes', components=[{'name': 'Txn optimized 5x buffer', 'volume': '4ul'}, {'name': 'DTT (100mM)', 'volume': '2ul'}, {'name': 'Recombinant RNasin', 'volume': '0.75ul'}, {'name': '10mM rATP', 'volume': '1ul'}, {'name': '10mM rUTP', 'volume': '1ul'}, {'name': '10mM rCTP', 'volume': '1ul'}, {'name': '10mM rGTP', 'volume': '1ul'}, {'name': '4tUTP (10mM)', 'volume': '2ul'}, {'name': 'SP6 RNA Polymerase', 'volume': '1ul'}])\nmake(container='new tubes', reagent='linearized plasmid DNA', volume='6.25ul')\ndilute(reagent='1ul provided standard with 5.25ul water', volume='1ul standard, 5.25ul water', purpose='kit positive control')\nadd(container='tube of linearized DNA', reagent='SP6 reaction master mix', volume='13.75ul')\nincubate(reagent='SP6 reaction', temperature='30/37C water bath', duration='1-2hr')\nremove(container='PCR tubes', reagent='2ul reaction', volume='2ul', purpose='for later gel')\nadd(container='remaining reaction', reagent='RQ1 RNase-Free DNase', volume='1ul')\nincubate(reagent='reaction with DNase', temperature='37C', duration='15min')\nadd(container='each reaction', reagent='Ampure XP beads', volume='40ul')\nmix(container='reaction tube', reagent='Ampure XP beads and reaction', method='pipette')\nwait(temperature='RT', duration='5min')\ncollect(container='magnetic rack', reagent='beads to side')\naspirate(reagent='supernatant', volume='all')\nadd(container='beads', reagent='80% etOH', volume='~500ul')\nwait(duration='~30 seconds')\naspirate(reagent='supernatant', volume='all')\nadd(container='beads', reagent='80% etOH', volume='~500ul')\nwait(duration='~30 seconds')\naspirate(reagent='supernatant', volume='all')\n\n### MANUAL SECTION ###\n# MANUAL: dry (container: rack with kimwipe over open tubes, reagent: beads, temperature: RT, duration: 10min, other: {})\n\n### AUTOMATED SECTION ###\nresuspend(container='tube', reagent='beads in hyclone H_2O', volume='20ul')\n\n### MANUAL SECTION ###\n# MANUAL: run (container: 1% agarose TAE gel, reagent: 3ul sample, NEB 1kb ladder, volume: 3ul, duration: 20min, other: {'voltage': '100V'})\n# MANUAL: visualize (reagent: gel with dye (sybrsafe), other: {})\n# MANUAL: quantify (reagent: sample, other: {'method': 'qubit'})\n\n### AUTOMATED SECTION ###\ndilute(reagent='sample')",
