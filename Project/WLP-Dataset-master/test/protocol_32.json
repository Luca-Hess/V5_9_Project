    "script": "# Lab Automation Script\n# Generated from protocol analysis\n\n\n### AUTOMATED SECTION ###\nrinse(container='60 mm culture dish', reagent='PBS')\nlyse(container='60 mm culture dish', reagent='Immunoprecipitation Buffer', volume='0.5 ml', temperature='cold')\nagitate(container='culture dish', temperature='4\u00b0C', duration='30 minutes', speed='constant')\n\n### MANUAL SECTION ###\n# MANUAL: scrape (container: culture dish, reagent: cells, other: {})\n# MANUAL: sonicate (temperature: on ice, duration: 5 seconds, other: {'repeat': '4 times'})\n\n### AUTOMATED SECTION ###\ncentrifuge(temperature='4\u00b0C', duration='5 minutes')\n\n### MANUAL SECTION ###\n# MANUAL: assay (reagent: total protein, other: {})\n\n### AUTOMATED SECTION ###\nadjust(reagent='Immunoprecipitation Buffer', volume='to approximately 1 mg/ml', target concentration='1 mg/ml')\nadd(container='1.5 ml microcentrifuge tube', reagent='Protein A/G Magnetic Beads', volume='25 \u03bcl', to='200 \u03bcl of crude cell extract')\nvortex(container='1.5 ml microcentrifuge tube', speed='gentle')\nincubate(container='1.5 ml microcentrifuge tube', temperature='4\u00b0C', duration='1 hour')\napply(container='1.5 ml microcentrifuge tube', duration='30 seconds', field='magnetic')\npipette(container='1.5 ml microcentrifuge tube', reagent='supernatant', to='clean 1.5 ml microcentrifuge tube', discard='beads')\nadd(reagent='antibody', volume='1-5 \u03bcg', to='crude cell lysate')\nvortex()\nincubate(temperature='4\u00b0C', duration='1 hour')\nadd(reagent='Protein A/G Magnetic Beads suspension', volume='25 \u03bcl')\nvortex(speed='gentle')\nincubate(temperature='4\u00b0C', duration='1 hour', speed='agitation')\napply(field='magnetic')\npipette(reagent='supernatant', remove='supernatant')\nwash(reagent='Immunoprecipitation Buffer', volume='500 \u03bcl', speed='gentle vortex', wash_number=1)\napply(field='magnetic', wash_number=1)\npipette(reagent='supernatant', remove='supernatant', discard=True, wash_number=1)\nwash(reagent='Immunoprecipitation Buffer', volume='500 \u03bcl', speed='gentle vortex', wash_number=2)\napply(field='magnetic', wash_number=2)\npipette(reagent='supernatant', remove='supernatant', discard=True, wash_number=2)\nwash(reagent='Immunoprecipitation Buffer', volume='500 \u03bcl', speed='gentle vortex', wash_number=3)\napply(field='magnetic', wash_number=3)\npipette(reagent='supernatant', remove='supernatant', discard=True, wash_number=3)\nresuspend(reagent='3X SDS Sample Loading Buffer', volume='30 \u03bcl', target='bead pellet')\nincubate(container='sample', temperature='70\u00b0C', duration='5 minutes')\napply(container='sample', field='magnetic')\nload(container='SDS-PAGE gel', reagent='supernatant')\nelectrophorese(container='SDS-PAGE gel')",
